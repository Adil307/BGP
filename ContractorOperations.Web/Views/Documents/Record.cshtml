@model List<DocumentRecord>
@{
    ViewData["Title"] = "Documents";
    var referenceType = (string)ViewBag.ReferenceType;
    var referenceId = (string)ViewBag.ReferenceId;
    string? referenceNumber = ViewBag.ReferenceNumber as string;
    int? projectId = ViewBag.ProjectId as int?;
    var canUpload = (bool)ViewBag.CanUpload;
    var canDelete = (bool)ViewBag.CanDelete;
    var canPrint = (bool)ViewBag.CanPrint;
    var uploaderNames = ViewBag.UploaderNames as Dictionary<string,string> ?? new();
}
<div class="page-heading"><div><h1>Documents</h1><p>@referenceType · @(referenceNumber ?? referenceId)</p></div><div class="page-actions"><a class="btn btn-outline-secondary" asp-action="Index"><i class="bi bi-folder2-open"></i> All Documents</a><button class="btn btn-outline-secondary" type="button" onclick="history.back()"><i class="bi bi-arrow-left"></i> Back</button></div></div>
@if(canUpload){
<section class="panel mb-3"><div class="subsection-title"><div><h3>Upload Document</h3><p>PDF, Word, Excel and image files up to 25 MB.</p></div></div>
<form asp-action="Upload" method="post" enctype="multipart/form-data" class="document-upload-grid">
<input type="hidden" name="referenceType" value="@referenceType"/><input type="hidden" name="referenceId" value="@referenceId"/><input type="hidden" name="projectId" value="@projectId"/>
<div><label class="form-label">Document</label><input type="file" class="form-control" name="file" accept=".pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png" required/></div>
<div><label class="form-label">Notes / Description</label><input class="form-control" name="notes" maxlength="1000" placeholder="Optional note about this document"/></div>
<div><label class="form-label">Replace Existing (optional)</label><select class="form-select" name="replaceDocumentId"><option value="">Upload as a new document</option>@foreach(var existing in Model){<option value="@existing.Id">@existing.OriginalFileName</option>}</select><small class="text-muted">Replacement keeps the previous revision in audit history.</small></div>
<div class="align-self-end"><button class="btn btn-primary"><i class="bi bi-cloud-arrow-up"></i> Upload Document</button></div>
</form></section>}
<section class="panel p-0 overflow-hidden"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>File</th><th>Notes</th><th>Uploaded By</th><th>Uploaded</th><th>Actions</th></tr></thead><tbody>
@if(!Model.Any()){<tr><td colspan="5" class="text-center py-5 text-muted">No documents are attached to this record yet.</td></tr>}
@foreach(var x in Model){<tr><td><strong>@x.OriginalFileName</strong><small>@((x.SizeBytes/1024d).ToString("N0")) KB</small></td><td>@(x.Notes ?? "-")</td><td>@(uploaderNames.TryGetValue(x.UploadedByUserId,out var uploadedBy)?uploadedBy:x.UploadedByUserId)</td><td>@x.UploadedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td><td><div class="action-row"><a class="btn btn-sm btn-outline-primary" asp-action="Preview" asp-route-id="@x.Id" target="_blank"><i class="bi bi-eye"></i> View</a><a class="btn btn-sm btn-outline-secondary" asp-action="Download" asp-route-id="@x.Id"><i class="bi bi-download"></i> Download</a>@if(canPrint){<a class="btn btn-sm btn-outline-secondary" asp-action="Print" asp-route-id="@x.Id" target="_blank"><i class="bi bi-printer"></i> Print</a>}@if(canDelete){<form asp-action="Delete" asp-route-id="@x.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this document?');"><button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button></form>}</div></td></tr>}
</tbody></table></div></section>
