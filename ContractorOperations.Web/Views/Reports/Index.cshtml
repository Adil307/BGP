@model ReportVm
@{ ViewData["Title"]="Reports"; var currencies=Model.DepartmentAmounts.SelectMany(x=>x.Amounts.Keys).Distinct().OrderBy(x=>x).ToList(); }
<div class="page-heading"><div><h1>Reports</h1><p>Department-wise job value, status summary and stock alerts.</p></div><div class="page-actions"><a class="btn btn-outline-secondary" asp-controller="Jobs" asp-action="ExportCsv"><i class="bi bi-download"></i> Jobs CSV</a><a class="btn btn-outline-secondary" asp-controller="Inventory" asp-action="ExportCsv"><i class="bi bi-download"></i> Inventory CSV</a></div></div>
<div class="dashboard-grid-2">
<section class="panel"><h3>Jobs by Status</h3><div class="report-kpis">@foreach(var x in Model.JobsByStatus){<div><span>@x.Key</span><strong>@x.Value</strong></div>}</div>@if(Model.InventoryValueByCurrency.Any()){<div class="inventory-values mt-3">@foreach(var v in Model.InventoryValueByCurrency){<span><strong>@v.Key @v.Value.ToString("N2")</strong> current stock value</span>}</div>}</section>
<section class="panel"><h3>Department Amounts — Currency Kept Separate</h3><div class="table-responsive"><table class="table"><thead><tr><th>Department</th><th>Jobs</th><th>Qty</th>@foreach(var c in currencies){<th>@c</th>}</tr></thead><tbody>@foreach(var r in Model.DepartmentAmounts){<tr><td><strong>@r.Department</strong></td><td>@r.JobCount</td><td>@r.Quantity.ToString("N3")</td>@foreach(var c in currencies){<td>@(r.Amounts.TryGetValue(c,out var v)?v.ToString("N2"):"-")</td>}</tr>}</tbody></table></div></section>
</div>
<section class="panel mt-3"><div class="panel-head"><h3>Low / Out of Stock</h3><a asp-controller="Inventory" asp-action="Index">Open inventory</a></div><div class="table-responsive"><table class="table"><thead><tr><th>Code</th><th>Item</th><th>Category</th><th>On Hand</th><th>Reorder</th><th>Unit Cost</th></tr></thead><tbody>@foreach(var x in Model.LowStockItems){<tr><td>@x.ItemCode</td><td>@x.Name</td><td>@x.Category</td><td><strong>@x.QuantityOnHand.ToString("N3") @x.Unit</strong></td><td>@x.ReorderLevel.ToString("N3")</td><td>@x.Currency @x.UnitCost.ToString("N2")</td></tr>}@if(!Model.LowStockItems.Any()){<tr><td colspan="6" class="empty-row">No low-stock items.</td></tr>}</tbody></table></div></section>
