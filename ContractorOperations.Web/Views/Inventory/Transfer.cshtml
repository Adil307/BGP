@model StockTransferVm
@{ ViewData["Title"]="Warehouse Transfer"; }
<div class="page-heading"><div><h1>Warehouse Transfer</h1><p>Move stock between warehouses in one atomic transaction.</p></div><a class="btn btn-outline-secondary" asp-action="Index">Back</a></div>
<form method="post"><section class="panel form-panel"><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><div class="form-grid-2"><div><label asp-for="StockItemId" class="form-label">Stock Item</label><select asp-for="StockItemId" asp-items="Model.Items" class="form-select"><option value="">Select item</option></select></div><div><label asp-for="Quantity" class="form-label"></label><input asp-for="Quantity" class="form-control" step="0.001"/></div><div><label asp-for="FromWarehouseId" class="form-label">From Warehouse</label><select asp-for="FromWarehouseId" asp-items="Model.Warehouses" class="form-select"><option value="">Select source</option></select></div><div><label asp-for="ToWarehouseId" class="form-label">To Warehouse</label><select asp-for="ToWarehouseId" asp-items="Model.Warehouses" class="form-select"><option value="">Select destination</option></select></div><div><label asp-for="ReferenceNo" class="form-label">Transfer Reference</label><input asp-for="ReferenceNo" class="form-control" placeholder="Auto-created if left blank"/></div></div><div class="mt-3"><label asp-for="Notes" class="form-label"></label><textarea asp-for="Notes" class="form-control" rows="3"></textarea></div><div class="form-actions"><button class="btn btn-primary">Transfer Stock</button></div></section></form>
