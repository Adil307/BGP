@model StockItemFormVm
@{ var edit=Model.Id.HasValue; ViewData["Title"]=edit?"Edit Stock Item":"Add Stock Item"; }
<div class="page-heading"><div><h1>@ViewData["Title"]</h1><p>Maintain controlled stock master data and reorder settings.</p></div><a class="btn btn-outline-secondary" asp-action="Index">Back</a></div>
<form method="post" asp-action="@(edit?"EditItem":"CreateItem")" asp-route-id="@Model.Id"><input type="hidden" asp-for="Id"/><section class="panel form-panel"><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><div class="form-grid-3"><div><label asp-for="ItemCode" class="form-label"></label><input asp-for="ItemCode" class="form-control"/><span asp-validation-for="ItemCode" class="text-danger small"></span></div><div><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control"/></div><div><label asp-for="StockCategoryId" class="form-label">Category</label><select asp-for="StockCategoryId" asp-items="Model.Categories" class="form-select"><option value="">Select category</option></select></div><div><label asp-for="UnitId" class="form-label">Unit</label><select asp-for="UnitId" asp-items="Model.Units" class="form-select"><option value="">Select unit</option></select></div><div><label asp-for="ReorderLevel" class="form-label"></label><input asp-for="ReorderLevel" class="form-control" step="0.001"/></div><div><label asp-for="UnitCost" class="form-label"></label><input asp-for="UnitCost" class="form-control" step="0.01"/></div><div><label asp-for="CurrencyId" class="form-label">Currency</label><select asp-for="CurrencyId" asp-items="Model.Currencies" class="form-select"><option value="">Select currency</option></select></div><div class="form-check form-switch align-self-end mb-2"><input asp-for="IsActive" class="form-check-input"/><label asp-for="IsActive" class="form-check-label">Active</label></div></div><div class="form-actions"><a class="btn btn-light" asp-action="Index">Cancel</a><button class="btn btn-primary">@(edit?"Save Changes":"Create Item")</button></div></section></form>
