@model List<StockTransaction>
@{ ViewData["Title"]="Stock Transactions"; }
<div class="page-heading"><div><h1>Stock Transactions</h1><p>Full movement history for receipts, issues and adjustments.</p></div><div class="page-actions"><a class="btn btn-success" asp-action="Receive">Receive</a><a class="btn btn-warning" asp-action="Issue">Issue</a><a class="btn btn-outline-primary" asp-action="Adjust" asp-route-increase="true">Adjust +</a><a class="btn btn-outline-danger" asp-action="Adjust" asp-route-increase="false">Adjust −</a></div></div>
<section class="panel filter-panel"><form method="get" class="d-flex gap-2"><select class="form-select" name="itemId"><option value="">All items</option>@foreach(var x in (SelectList)ViewBag.Items){<option value="@x.Value" selected="@x.Selected">@x.Text</option>}</select><select class="form-select" name="warehouseId"><option value="">All warehouses</option>@foreach(var x in (SelectList)ViewBag.Warehouses){<option value="@x.Value" selected="@x.Selected">@x.Text</option>}</select><button class="btn btn-primary">Filter</button><a class="btn btn-light" asp-action="Index">Inventory</a></form></section>
<section class="panel mt-3"><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Date</th><th>Type</th><th>Item</th><th>Warehouse</th><th>Qty</th><th>Cost</th><th>Job</th><th>Reference</th><th>User</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td><td><span class="stock-move @x.Type.ToString().ToLowerInvariant()">@x.Type</span></td><td>@x.StockItem?.ItemCode - @x.StockItem?.Name</td><td>@x.Warehouse?.Name</td><td><strong>@x.Quantity.ToString("N3")</strong></td><td>@x.Currency?.Code @x.UnitCost.ToString("N2")</td><td>@(x.Job?.JobNumber??"-")</td><td>@(x.ReferenceNo??"-")</td><td>@x.CreatedByUser?.FullName</td></tr>}@if(!Model.Any()){<tr><td colspan="9" class="empty-row">No transactions found.</td></tr>}</tbody></table></div></section>
