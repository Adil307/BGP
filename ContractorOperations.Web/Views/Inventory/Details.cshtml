@model StockItem
@{ ViewData["Title"]=$"Stock {Model.ItemCode}"; var tx=(List<StockTransaction>)ViewBag.Transactions; var total=Model.Balances.Sum(x=>x.QuantityOnHand); }
<div class="page-heading"><div><h1>@Model.ItemCode — @Model.Name</h1><p>@Model.StockCategory?.Name · @Model.Unit?.Code · Reorder @Model.ReorderLevel.ToString("N3")</p></div><div class="page-actions no-print"><a class="btn btn-outline-secondary" asp-controller="Documents" asp-action="Record" asp-route-referenceType="StockItem" asp-route-referenceId="@Model.Id"><i class="bi bi-folder2-open"></i> Documents</a><button class="btn btn-outline-secondary" onclick="window.print()"><i class="bi bi-printer"></i> Print</button><a class="btn btn-outline-primary" asp-action="EditItem" asp-route-id="@Model.Id">Edit Item</a><a class="btn btn-outline-secondary" asp-action="Index">Back</a></div></div>
<div class="kpi-grid"><div class="kpi blue"><div class="kpi-icon"><i class="bi bi-boxes"></i></div><div><strong>@total.ToString("N3")</strong><span>Total On Hand</span></div></div><div class="kpi amber"><div class="kpi-icon"><i class="bi bi-arrow-repeat"></i></div><div><strong>@Model.ReorderLevel.ToString("N3")</strong><span>Reorder Level</span></div></div><div class="kpi green"><div class="kpi-icon"><i class="bi bi-cash"></i></div><div><strong>@Model.UnitCost.ToString("N2")</strong><span>@Model.Currency?.Code Unit Cost</span></div></div><div class="kpi red"><div class="kpi-icon"><i class="bi bi-building"></i></div><div><strong>@Model.Balances.Count</strong><span>Warehouse Balances</span></div></div></div>
<div class="dashboard-grid-2"><section class="panel"><h3>Balance by Warehouse</h3><table class="table"><thead><tr><th>Warehouse</th><th>Location</th><th>On Hand</th><th>Last Updated</th></tr></thead><tbody>@foreach(var b in Model.Balances.OrderBy(x=>x.Warehouse!.Name)){<tr><td>@b.Warehouse?.Name</td><td>@b.Warehouse?.Location</td><td><strong>@b.QuantityOnHand.ToString("N3") @Model.Unit?.Code</strong></td><td>@b.UpdatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td></tr>}@if(!Model.Balances.Any()){<tr><td colspan="4" class="empty-row">No stock has been posted yet.</td></tr>}</tbody></table></section><section class="panel"><h3>Quick Stock Actions</h3><div class="quick-row"><a class="quick green" asp-action="Receive"><i class="bi bi-box-arrow-in-down"></i>Receive</a><a class="quick amber" asp-action="Issue"><i class="bi bi-box-arrow-up"></i>Issue</a><a class="quick purple" asp-action="Transfer"><i class="bi bi-arrow-left-right"></i>Transfer</a><a class="quick gray" asp-action="Adjust"><i class="bi bi-sliders"></i>Adjust</a></div></section></div>
<section class="panel mt-3"><div class="panel-head"><h3>Recent Transactions</h3><a asp-action="Transactions" asp-route-itemId="@Model.Id">View all</a></div><div class="table-responsive"><table class="table"><thead><tr><th>Date</th><th>Type</th><th>Warehouse</th><th>Qty</th><th>Reference</th><th>User</th></tr></thead><tbody>@foreach(var x in tx){<tr><td>@x.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td><td>@x.Type</td><td>@x.Warehouse?.Name</td><td>@x.Quantity.ToString("N3")</td><td>@x.ReferenceNo</td><td>@x.CreatedByUser?.FullName</td></tr>}</tbody></table></div></section>
