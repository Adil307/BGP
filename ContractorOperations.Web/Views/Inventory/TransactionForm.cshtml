@model StockTransactionFormVm
@{ ViewData["Title"]=Model.Type switch { StockTransactionType.Receive=>"Receive Stock", StockTransactionType.Issue=>"Issue Stock", StockTransactionType.AdjustmentIn=>"Stock Adjustment (+)", _=>"Stock Adjustment (-)"}; }
<div class="page-heading"><div><h1>@ViewData["Title"]</h1><p>Post a controlled inventory movement. Negative stock is automatically blocked.</p></div><a class="btn btn-outline-secondary" asp-action="Index">Back</a></div>
<form asp-action="PostTransaction" method="post"><input type="hidden" asp-for="Type"/><section class="panel form-panel"><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><div class="form-grid-3"><div><label asp-for="StockItemId" class="form-label">Stock Item</label><select asp-for="StockItemId" asp-items="Model.Items" class="form-select"><option value="">Select item</option></select></div><div><label asp-for="WarehouseId" class="form-label">Warehouse</label><select asp-for="WarehouseId" asp-items="Model.Warehouses" class="form-select"><option value="">Select warehouse</option></select></div><div><label asp-for="Quantity" class="form-label"></label><input asp-for="Quantity" class="form-control" step="0.001"/></div><div><label asp-for="UnitCost" class="form-label">Unit Cost</label><input asp-for="UnitCost" class="form-control" step="0.01"/></div><div><label asp-for="CurrencyId" class="form-label">Currency</label><select asp-for="CurrencyId" asp-items="Model.Currencies" class="form-select"></select></div><div><label asp-for="ReferenceNo" class="form-label">Reference / GRN / Issue No.</label><input asp-for="ReferenceNo" class="form-control"/></div><div><label asp-for="JobId" class="form-label">Linked Job (optional)</label><select asp-for="JobId" asp-items="Model.Jobs" class="form-select"><option value="">Not linked</option></select></div><div><label asp-for="ContractorId" class="form-label">Contractor (optional)</label><select asp-for="ContractorId" asp-items="Model.Contractors" class="form-select"><option value="">Not specified</option></select></div></div><div class="mt-3"><label asp-for="Notes" class="form-label"></label><textarea asp-for="Notes" class="form-control" rows="3"></textarea></div><div class="form-actions"><a class="btn btn-light" asp-action="Index">Cancel</a><button class="btn btn-primary">Post @ViewData["Title"]</button></div></section></form>
