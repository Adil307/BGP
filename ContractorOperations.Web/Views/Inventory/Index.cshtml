@model InventoryDashboardVm
@{ ViewData["Title"]="Stock Inventory"; }
<div class="page-heading"><div><h1>Stock Inventory</h1><p>Real-time stock balances, reorder visibility and transaction controls.</p></div><div class="page-actions"><a class="btn btn-outline-secondary" asp-action="ExportCsv"><i class="bi bi-download"></i> Export</a><a class="btn btn-outline-success" asp-action="Receive"><i class="bi bi-box-arrow-in-down"></i> Receive</a><a class="btn btn-outline-warning" asp-action="Issue"><i class="bi bi-box-arrow-up"></i> Issue</a><a class="btn btn-outline-primary" asp-action="Transfer"><i class="bi bi-arrow-left-right"></i> Transfer</a><a class="btn btn-primary" asp-action="CreateItem"><i class="bi bi-plus-lg"></i> Add Item</a></div></div>
<div class="kpi-grid"><div class="kpi blue"><div class="kpi-icon"><i class="bi bi-boxes"></i></div><div><strong>@Model.TotalItems</strong><span>Active Items</span></div></div><div class="kpi amber"><div class="kpi-icon"><i class="bi bi-exclamation-triangle"></i></div><div><strong>@Model.LowStock</strong><span>Low Stock</span></div></div><div class="kpi red"><div class="kpi-icon"><i class="bi bi-x-octagon"></i></div><div><strong>@Model.OutOfStock</strong><span>Out of Stock</span></div></div><div class="kpi green"><div class="kpi-icon"><i class="bi bi-building"></i></div><div><strong>@Model.Warehouses</strong><span>Warehouses</span></div></div></div>
<section class="panel filter-panel"><form method="get" class="d-flex gap-2"><input class="form-control" name="q" placeholder="Search item code, item name or category"/><button class="btn btn-primary">Search</button><a class="btn btn-light" asp-action="Transactions">Transactions</a></form></section>
<section class="panel mt-3"><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Item Code</th><th>Item</th><th>Category</th><th>Unit</th><th>On Hand</th><th>Reorder</th><th>Unit Cost</th><th>Status</th><th>Action</th></tr></thead><tbody>@foreach(var x in Model.Items){var state=x.QuantityOnHand<=0?"Out of Stock":x.QuantityOnHand<=x.ReorderLevel?"Low Stock":"In Stock";<tr><td><strong>@x.ItemCode</strong></td><td>@x.Name</td><td>@x.Category</td><td>@x.Unit</td><td><strong>@x.QuantityOnHand.ToString("N3")</strong></td><td>@x.ReorderLevel.ToString("N3")</td><td>@x.Currency @x.UnitCost.ToString("N2")</td><td><span class="stock-state @(state=="In Stock"?"ok":state=="Low Stock"?"low":"out")">@state</span></td><td class="actions"><a asp-action="Details" asp-route-id="@x.Id"><i class="bi bi-eye"></i></a><a asp-action="EditItem" asp-route-id="@x.Id"><i class="bi bi-pencil"></i></a></td></tr>}@if(!Model.Items.Any()){<tr><td colspan="9" class="empty-row">No stock items found.</td></tr>}</tbody></table></div></section>
