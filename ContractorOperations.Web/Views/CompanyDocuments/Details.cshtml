@model CompanyDocumentDetailsVm
@inject IPermissionService PermissionService
@{
    ViewData["Title"]=Model.Document.Title;
    var canGenerate=await PermissionService.HasPermissionAsync(User,"Documents.Generate");
    var canSign=await PermissionService.HasPermissionAsync(User,"Documents.Sign");
    var canFinalize=await PermissionService.HasPermissionAsync(User,"Documents.Finalize");
    var canPrint=await PermissionService.HasPermissionAsync(User,"Documents.Print");
    var isDraft=Model.Document.Status==GeneratedDocumentStatus.Draft;
}
<div class="page-heading"><div><span class="reference-chip">@Model.Template?.DocumentType</span><h1>@Model.Document.Title</h1><p>@Model.Document.ReferenceType · <strong>@(Model.Document.ReferenceNumber??Model.Document.ReferenceId)</strong></p></div><div class="page-actions no-print">@if(canGenerate&&isDraft){<a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Document.Id"><i class="bi bi-pencil"></i> Edit Text</a>}<a class="btn btn-outline-secondary" asp-action="Preview" asp-route-id="@Model.Document.Id" target="_blank"><i class="bi bi-eye"></i> Preview</a>@if(canPrint){<a class="btn btn-primary" asp-action="Print" asp-route-id="@Model.Document.Id" target="_blank"><i class="bi bi-printer"></i> Print / PDF</a>}<a class="btn btn-outline-secondary" asp-action="Index">Back</a></div></div>
<div class="service-approval-statusbar"><div><small>Status</small><strong class="status @Model.Document.Status.ToString().ToLowerInvariant()">@Model.Document.Status</strong></div><div><small>Master Template</small><strong>@Model.Template?.Name</strong></div><div><small>Reference</small><strong>@(Model.Document.ReferenceNumber??Model.Document.ReferenceId)</strong></div><div><small>Updated</small><strong>@Model.Document.UpdatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</strong></div></div>
@if(Model.Document.Status==GeneratedDocumentStatus.Voided){<div class="alert alert-danger mt-3"><strong>VOIDED</strong><br/>@Model.Document.VoidReason</div>}
<div class="dashboard-grid-2 mt-3"><section class="panel"><h3>Document Control</h3><dl class="detail-grid"><dt>Document ID</dt><dd>@Model.Document.Id</dd><dt>Linked Type</dt><dd>@Model.Document.ReferenceType</dd><dt>Requisition</dt><dd>@(Model.Document.RequisitionNumber??"-")</dd><dt>Created</dt><dd>@Model.Document.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</dd><dt>Finalized</dt><dd>@(Model.Document.FinalizedAt?.ToLocalTime().ToString("dd MMM yyyy HH:mm")??"-")</dd></dl></section><section class="panel"><h3>Protection</h3><div class="document-policy-note"><i class="bi bi-lock"></i><div><strong>@(isDraft?"Controlled Draft":"Locked Business Record")</strong><p>@(isDraft?"Text, signatures and stamp can still be changed according to permission.":"Final content is stored as a rendered snapshot. The master template cannot change this record.")</p></div></div></section></div>
<section class="panel mt-3"><div class="subsection-title mt-0 pt-0 border-0"><div><h3>Signature Positions</h3><p>Each person applies only their own saved signature. The signature is placed automatically in the selected template slot.</p></div></div>
@if(Model.SignatureSlotLabels.Length==0){<div class="empty-state-compact">This template does not define manual signature slots. Workflow signatures may be supplied automatically from the linked Service Approval.</div>}
else{<div class="document-signature-slots">@for(var i=0;i<Model.SignatureSlotLabels.Length;i++){var slot=i+1;var sig=Model.Signatures.FirstOrDefault(x=>x.SlotNumber==slot);<div class="document-signature-slot"><div><span class="stage-number">@slot</span><strong>@Model.SignatureSlotLabels[i]</strong></div>@if(sig!=null){<img src="@Url.Action("UserSignature","Account",new{id=sig.UserSignatureId})" alt="Signature"/><small>@(Model.UserNames.TryGetValue(sig.AppliedByUserId,out var signer)?signer:sig.AppliedByUserId)<br/>@sig.AppliedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</small>@if(isDraft&&canSign){<form asp-action="RemoveSignature" method="post"><input type="hidden" name="id" value="@Model.Document.Id"/><input type="hidden" name="slotNumber" value="@slot"/><button class="btn btn-sm btn-outline-danger">Remove</button></form>}}else if(isDraft&&canSign){@if(!Model.CurrentUserHasSignature){<small class="text-warning">Upload your signature in My Profile first.</small>}else{<form asp-action="ApplySignature" method="post"><input type="hidden" name="id" value="@Model.Document.Id"/><input type="hidden" name="slotNumber" value="@slot"/><button class="btn btn-sm btn-outline-primary"><i class="bi bi-pen"></i> Sign This Position</button></form>}}</div>}</div>}
</section>
<section class="panel mt-3"><div class="subsection-title mt-0 pt-0 border-0"><div><h3>Company Stamp</h3><p>The central company stamp is placed only at the template's <code>{{CompanyStamp}}</code> position.</p></div></div>@if(Model.HasCompanyStamp){var stamp=Model.AssetUsages.First(x=>x.OfficialDocumentAsset?.AssetType=="CompanyStamp");<div class="company-stamp-control"><img src="@Url.Action("OfficialAsset","Settings",new{id=stamp.OfficialDocumentAssetId})"/><div><strong>Stamp Applied</strong><small>@(Model.UserNames.TryGetValue(stamp.AppliedByUserId,out var stampUser)?stampUser:stamp.AppliedByUserId) · @stamp.AppliedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</small>@if(isDraft&&canSign){<form asp-action="RemoveCompanyStamp" method="post" class="mt-2"><input type="hidden" name="id" value="@Model.Document.Id"/><button class="btn btn-sm btn-outline-danger">Remove from Draft</button></form>}</div></div>}else if(isDraft&&canSign){<form asp-action="ApplyCompanyStamp" method="post"><input type="hidden" name="id" value="@Model.Document.Id"/><button class="btn btn-outline-primary"><i class="bi bi-patch-check"></i> Apply Company Stamp</button></form>}</section>
@if(isDraft&&canFinalize){<section class="panel mt-3 finalize-panel"><div><i class="bi bi-shield-lock"></i><div><h3>Finalize Document</h3><p>Finalization stores a permanent rendered snapshot and disables text/signature/stamp edits.</p></div></div><form asp-action="Finalize" method="post" onsubmit="return confirm('Finalize and lock this document?');"><input type="hidden" name="id" value="@Model.Document.Id"/><button class="btn btn-success"><i class="bi bi-check2-circle"></i> Finalize &amp; Lock</button></form></section>}
@if(Model.Document.Status==GeneratedDocumentStatus.Finalized&&canFinalize){<section class="panel mt-3 danger-zone"><h3>Void Final Record</h3><p class="text-muted">Do not delete finalized business records. If the record is invalid, void it with a reason.</p><form asp-action="Void" method="post" class="document-void-form"><input type="hidden" name="id" value="@Model.Document.Id"/><input class="form-control" name="reason" placeholder="Required void reason" required/><button class="btn btn-outline-danger">Void Document</button></form></section>}
<section class="panel mt-3"><div class="subsection-title mt-0 pt-0 border-0"><div><h3>Audit History</h3><p>Read-only business history.</p></div></div><div class="audit-mini-list">@if(!Model.AuditHistory.Any()){<p class="text-muted">No audit entries yet.</p>}@foreach(var h in Model.AuditHistory){<div><strong>@h.Action</strong><span>@(h.UserName??"System") · @h.TimestampUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</span><p>@h.Details</p></div>}</div></section>
