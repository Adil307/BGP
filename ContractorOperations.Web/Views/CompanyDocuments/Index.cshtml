@model CompanyDocumentLibraryVm
@inject IPermissionService PermissionService
@{
    ViewData["Title"]="Company Document Library";
    var canGenerate = await PermissionService.HasPermissionAsync(User,"Documents.Generate");
    var canManageTemplates = await PermissionService.HasPermissionAsync(User,"DocumentTemplates.Manage");
    string StatusLabel(GeneratedDocumentStatus s) => s.ToString();
}
<div class="page-heading"><div><span class="reference-chip">CONTROLLED DOCUMENTS</span><h1>Company Document Library</h1><p>Reusable company forms, record-linked drafts, individual signatures, controlled stamp placement and locked final copies.</p></div><div class="page-actions">@if(canGenerate){<a class="btn btn-primary" asp-action="Create"><i class="bi bi-file-earmark-plus"></i> New Document</a>}@if(canManageTemplates){<a class="btn btn-outline-primary" asp-controller="DocumentTemplates" asp-action="Index"><i class="bi bi-layout-text-window"></i> Manage Templates</a>}</div></div>
<section class="panel mb-3">
<div class="subsection-title mt-0 pt-0 border-0"><div><h3>Master Company Forms</h3><p>Use a controlled master template. Generated documents keep their own snapshot, so later template edits do not alter old records.</p></div></div>
@if(!Model.Templates.Any()){<div class="empty-state-compact">No active company templates yet.</div>}else{<div class="company-template-grid">@foreach(var t in Model.Templates){<article class="company-template-card"><div class="template-type">@t.DocumentType</div><h4>@t.Name</h4><p>@(string.IsNullOrWhiteSpace(t.Description)?"Reusable company document template.":t.Description)</p><div class="template-card-meta">@if(!string.IsNullOrWhiteSpace(t.SourceOriginalFileName)){<span><i class="bi bi-paperclip"></i> Source: @t.SourceOriginalFileName</span>}<span><i class="bi bi-clock"></i> @t.UpdatedAt.ToLocalTime().ToString("dd MMM yyyy")</span></div><div class="action-row">@if(canGenerate){<a class="btn btn-sm btn-primary" asp-action="Create" asp-route-templateId="@t.Id">Use Template</a>}<a class="btn btn-sm btn-outline-secondary" asp-controller="DocumentTemplates" asp-action="Preview" asp-route-id="@t.Id" target="_blank">Preview</a>@if(canManageTemplates){<a class="btn btn-sm btn-outline-secondary" asp-controller="DocumentTemplates" asp-action="Edit" asp-route-id="@t.Id">Edit Master</a>}</div></article>}</div>}
</section>
<form method="get" class="panel filter-panel mb-3"><div class="document-library-search"><input class="form-control" name="q" value="@Model.Query" placeholder="Search title, requisition, job or reference..."/><button class="btn btn-outline-primary">Search</button><a class="btn btn-light" asp-action="Index">Clear</a></div></form>
<section class="panel p-0 overflow-hidden"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Document</th><th>Template</th><th>Linked Record</th><th>Status</th><th>Updated</th><th>Actions</th></tr></thead><tbody>
@if(!Model.Documents.Any()){<tr><td colspan="6" class="text-center py-5 text-muted">No generated company documents yet.</td></tr>}
@foreach(var d in Model.Documents){<tr><td><strong>@d.Title</strong><small class="d-block text-muted">#@d.Id</small></td><td>@d.DocumentTemplate?.Name<br/><small>@d.DocumentTemplate?.DocumentType</small></td><td>@(d.ReferenceNumber ?? d.ReferenceId)<br/><small>@d.ReferenceType</small></td><td><span class="status @d.Status.ToString().ToLowerInvariant()">@StatusLabel(d.Status)</span></td><td>@d.UpdatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td><td><div class="action-row"><a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@d.Id">Open</a><a class="btn btn-sm btn-outline-secondary" asp-action="Preview" asp-route-id="@d.Id" target="_blank">Preview</a></div></td></tr>}
</tbody></table></div></section>
