@model CompanyDocumentCreateVm
@{ ViewData["Title"]="Generate Company Document"; }
<div class="page-heading"><div><h1>Generate Company Document</h1><p>Create a controlled draft from a master company template. Linked BGP values auto-fill at preview/print time.</p></div><a class="btn btn-outline-secondary" asp-action="Index">Back</a></div>
<form method="post"><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
<input type="hidden" asp-for="ServiceApprovalId"/><input type="hidden" asp-for="JobId"/><input type="hidden" asp-for="RequisitionNumber"/><input type="hidden" asp-for="ProjectId"/>
<section class="panel form-panel"><div class="document-link-banner"><i class="bi bi-link-45deg"></i><div><small>Linked Record</small><strong>@Model.LinkedReferenceLabel</strong></div></div><div class="form-grid-2 mt-3"><div><label asp-for="DocumentTemplateId" class="form-label">Master Template</label><select asp-for="DocumentTemplateId" asp-items="Model.Templates" class="form-select"><option value="">Select company template</option></select><span asp-validation-for="DocumentTemplateId" class="text-danger small"></span></div><div><label asp-for="Title" class="form-label">Document Title</label><input asp-for="Title" class="form-control"/><span asp-validation-for="Title" class="text-danger small"></span></div></div><div class="document-policy-note mt-3"><i class="bi bi-shield-check"></i><div><strong>Master-safe generation</strong><p>The master template is never edited by this action. A version snapshot is saved with this generated document.</p></div></div><div class="form-actions"><a class="btn btn-light" asp-action="Index">Cancel</a><button class="btn btn-primary"><i class="bi bi-file-earmark-plus"></i> Create Draft</button></div></section>
</form>
