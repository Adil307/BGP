@inject ContractorOperations.Web.Data.ApplicationDbContext Db
@inject IPermissionService PermissionService
@{
    var settings = await Db.SystemSettings.AsNoTracking().FirstOrDefaultAsync();
    var company = settings?.CompanyName ?? "Your Company";
    var tagline = settings?.CompanyTagline ?? "Build | Operate | Grow";
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - @company</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
@if (User.Identity?.IsAuthenticated == true)
{
    <aside class="sidebar" id="sidebar">
        <div class="brand-wrap">
            <div class="brand-icon"><img src="~/images/bgp-logo.jpeg" alt="BGP logo" class="brand-logo-img" /></div>
            <div><div class="brand-name">@company</div><div class="brand-tag">@tagline</div></div>
        </div>
        <nav class="side-nav">
            @if (await PermissionService.HasPermissionAsync(User,"Dashboard.View")) { <a class="@(ctrl=="Workspace"?"active":"")" asp-controller="Workspace" asp-action="Index"><i class="bi bi-globe2"></i>Countries & Projects</a> }
            @if (await PermissionService.HasPermissionAsync(User,"Dashboard.View")) { <a class="@(ctrl=="Dashboard"?"active":"")" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-grid-fill"></i>Dashboard</a> }
            @if (await PermissionService.HasPermissionAsync(User,"Jobs.View")) { <a class="@(ctrl=="Jobs"?"active":"")" asp-controller="Jobs" asp-action="Index"><i class="bi bi-clipboard2-data"></i>Jobs</a> }
            @if (await PermissionService.HasPermissionAsync(User,"Jobs.Create")) { <a asp-controller="Jobs" asp-action="Create"><i class="bi bi-plus-circle"></i>Add Job</a> }
            @if (await PermissionService.HasPermissionAsync(User,"Sheets.View")) { <a class="@(ctrl=="Sheets"?"active":"")" asp-controller="Sheets" asp-action="Index"><i class="bi bi-table"></i>Sheets</a> }
            @if (await PermissionService.HasPermissionAsync(User,"Inventory.View")) { <a class="@(ctrl=="Inventory"?"active":"")" asp-controller="Inventory" asp-action="Index"><i class="bi bi-box-seam"></i>Stock Inventory</a> }
            @if (await PermissionService.HasPermissionAsync(User,"Inventory.Requests")) { <a class="@(ctrl=="InventoryRequests"?"active":"")" asp-controller="InventoryRequests" asp-action="Index"><i class="bi bi-box-arrow-in-down"></i>Inventory Requests</a> }
            @if (await PermissionService.HasPermissionAsync(User,"Departments.Manage")) { <a asp-controller="MasterData" asp-action="Index" asp-route-type="departments"><i class="bi bi-diagram-3"></i>Departments</a> }
            @if (await PermissionService.HasPermissionAsync(User,"Contractors.Manage")) { <a asp-controller="MasterData" asp-action="Index" asp-route-type="contractors"><i class="bi bi-person-gear"></i>Contractors</a> }
            @if (await PermissionService.HasPermissionAsync(User,"Reports.View")) { <a class="@(ctrl=="Reports"?"active":"")" asp-controller="Reports" asp-action="Index"><i class="bi bi-bar-chart"></i>Reports</a> }
            @if (await PermissionService.HasPermissionAsync(User,"Users.View")) { <a class="@(ctrl=="Users"?"active":"")" asp-controller="Users" asp-action="Index"><i class="bi bi-people"></i>Users</a> }
            @if (await PermissionService.HasPermissionAsync(User,"Permissions.Manage")) { <a class="@(ctrl=="Permissions"?"active":"")" asp-controller="Permissions" asp-action="Index"><i class="bi bi-shield-lock"></i>Users & Permissions</a> }
            @if (await PermissionService.HasPermissionAsync(User,"MasterData.Manage")) { <a class="@(ctrl=="MasterData"?"active":"")" asp-controller="MasterData" asp-action="Index" asp-route-type="currencies"><i class="bi bi-database-gear"></i>Master Data</a> }
            @if (await PermissionService.HasPermissionAsync(User,"Audit.View")) { <a class="@(ctrl=="AuditLogs"?"active":"")" asp-controller="AuditLogs" asp-action="Index"><i class="bi bi-journal-text"></i>Audit Log</a> }
            @if (await PermissionService.HasPermissionAsync(User,"Settings.Manage")) { <a class="@(ctrl=="Settings"?"active":"")" asp-controller="Settings" asp-action="Index"><i class="bi bi-gear"></i>Settings</a> }
        </nav>
        <div class="sidebar-footer">BGP Management System<br/><span>Version 2.1</span></div>
    </aside>
    <header class="topbar">
        <button class="icon-btn" id="sidebarToggle" type="button" aria-label="Toggle navigation menu" aria-controls="sidebar" aria-expanded="true"><i class="bi bi-list"></i></button>
        <form asp-controller="Jobs" asp-action="Index" method="get" class="top-search"><input name="q" placeholder="Search jobs, project, contractor..."/><button><i class="bi bi-search"></i></button></form>
        <a class="top-user text-decoration-none text-reset" asp-controller="Account" asp-action="Profile"><div class="avatar"><i class="bi bi-person-fill"></i></div><div><strong>@User.Identity?.Name</strong><small>My Profile</small></div></a>
        <form asp-controller="Account" asp-action="Logout" method="post"><button class="icon-btn" title="Logout"><i class="bi bi-box-arrow-right"></i></button></form>
    </header>
    <main class="main-content">
        @if (TempData["Success"] != null) { <div class="alert alert-success alert-dismissible fade show">@TempData["Success"]<button class="btn-close" data-bs-dismiss="alert"></button></div> }
        @if (TempData["Error"] != null) { <div class="alert alert-danger alert-dismissible fade show">@TempData["Error"]<button class="btn-close" data-bs-dismiss="alert"></button></div> }
        @RenderBody()
    </main>
}
else
{
    <main>@RenderBody()</main>
}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
