@model SystemSetting
@{
    ViewData["Title"]="Settings";
    var stamp = ViewBag.CompanyStamp as OfficialDocumentAsset;
}
<div class="page-heading"><div><h1>Settings</h1><p>Company identity and controlled company document assets.</p></div></div>
<form method="post"><input type="hidden" asp-for="Id"/><section class="panel form-panel mb-3"><div class="subsection-title"><div><h3>Company Details</h3><p>Used across the BGP interface and generated company documents.</p></div></div><div class="form-grid-2"><div><label asp-for="CompanyName" class="form-label"></label><input asp-for="CompanyName" class="form-control"/></div><div><label asp-for="CompanyTagline" class="form-label"></label><input asp-for="CompanyTagline" class="form-control"/></div><div><label asp-for="SupportEmail" class="form-label"></label><input asp-for="SupportEmail" class="form-control"/></div><div><label asp-for="ServiceApprovalPrefix" class="form-label">Service Approval Prefix</label><input asp-for="ServiceApprovalPrefix" class="form-control" maxlength="20" placeholder="SA"/><small class="text-muted">Example: SA → SA-2026-0001</small></div></div><div class="form-actions"><button class="btn btn-primary">Save Settings</button></div></section></form>
<section class="panel"><div class="subsection-title mt-0 pt-0 border-0"><div><h3>Company Document Asset</h3><p>The company stamp is a centrally controlled master asset. Personal signatures are managed by each authorized user from <strong>My Profile</strong>.</p></div></div>
<div class="official-assets-grid official-assets-grid-single">
<div class="official-asset-card"><div><span class="reference-chip">OFFICIAL COMPANY ASSET</span><h4>Company Stamp</h4><p>Authorized workflows can place this stamp only in template-defined stamp locations. Every application is audit-recorded.</p></div>@if(stamp!=null){<div class="official-asset-preview"><img src="@Url.Action("OfficialAsset",new{id=stamp.Id})" alt="Official company stamp"/></div><small>Updated @stamp.UpdatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</small>}else{<div class="official-asset-empty">No company stamp configured</div>}<form asp-action="UploadOfficialAsset" method="post" enctype="multipart/form-data"><input type="hidden" name="assetType" value="CompanyStamp"/><input class="form-control mb-2" type="file" name="file" accept=".png,.jpg,.jpeg" required/><button class="btn btn-outline-primary"><i class="bi bi-upload"></i> @(stamp==null?"Upload":"Replace") Company Stamp</button></form>@if(stamp!=null){<form asp-action="DeleteOfficialAsset" asp-route-id="@stamp.Id" method="post" onsubmit="return confirm('Deactivate the official company stamp?');"><button class="btn btn-sm btn-outline-danger mt-2"><i class="bi bi-trash"></i> Delete</button></form>}</div>
</div>
<div class="document-policy-note mt-3"><i class="bi bi-person-check"></i><div><strong>Individual signatures</strong><p>Managers and other authorized approvers upload only their own signature in My Profile. BGP never uses one shared person signature for multiple people.</p></div></div>
</section>
