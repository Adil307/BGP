@model SystemSetting
@{ ViewData["Title"]="Settings"; }
<div class="page-heading"><div><h1>Settings</h1><p>Basic company branding and support contact.</p></div></div>
<form method="post"><input type="hidden" asp-for="Id"/><section class="panel form-panel"><div class="form-grid-2"><div><label asp-for="CompanyName" class="form-label"></label><input asp-for="CompanyName" class="form-control"/></div><div><label asp-for="CompanyTagline" class="form-label"></label><input asp-for="CompanyTagline" class="form-control"/></div><div><label asp-for="SupportEmail" class="form-label"></label><input asp-for="SupportEmail" class="form-control"/></div></div><div class="form-actions"><button class="btn btn-primary">Save Settings</button></div></section></form>
