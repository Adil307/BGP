@model List<AuditLog>
@{ ViewData["Title"]="Audit Log"; }
<div class="page-heading"><div><h1>Audit Log</h1><p>Trace important create, edit, delete, security and stock actions.</p></div></div>
<section class="panel filter-panel"><form method="get" class="d-flex gap-2"><input class="form-control" name="q" value="@ViewBag.Query" placeholder="Search user, action, entity or details"/><button class="btn btn-primary">Search</button></form></section>
<section class="panel mt-3"><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Time</th><th>User</th><th>Action</th><th>Entity</th><th>ID</th><th>Details</th><th>IP</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.TimestampUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm:ss")</td><td>@(x.UserName??"System")</td><td><strong>@x.Action</strong></td><td>@x.EntityName</td><td>@x.EntityId</td><td>@x.Details</td><td>@x.IpAddress</td></tr>}@if(!Model.Any()){<tr><td colspan="7" class="empty-row">No audit entries.</td></tr>}</tbody></table></div><div class="d-flex justify-content-between"><a class="btn btn-light @(ViewBag.Page<=1?"disabled":"")" asp-route-page="@(ViewBag.Page-1)" asp-route-q="@ViewBag.Query">Previous</a><a class="btn btn-light" asp-route-page="@(ViewBag.Page+1)" asp-route-q="@ViewBag.Query">Next</a></div></section>
