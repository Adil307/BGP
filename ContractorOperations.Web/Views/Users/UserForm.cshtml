@model UserFormVm
@{ var edit=!string.IsNullOrWhiteSpace(Model.Id); ViewData["Title"]=edit?"Edit User":"Add User"; }
<div class="page-heading"><div><h1>@ViewData["Title"]</h1><p>Assign a role plus one or more departments. Individual permissions can be changed afterward.</p></div><a class="btn btn-outline-secondary" asp-action="Index">Back</a></div>
<form method="post" asp-action="@(edit?"Edit":"Create")" asp-route-id="@Model.Id"><input type="hidden" asp-for="Id"/><section class="panel form-panel"><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><div class="form-grid-2"><div><label asp-for="FullName" class="form-label"></label><input asp-for="FullName" class="form-control"/></div><div><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control"/></div><div><label asp-for="Role" class="form-label"></label><select asp-for="Role" asp-items="Model.Roles" class="form-select"></select></div>@if(!edit){<div><label asp-for="Password" class="form-label">Temporary Password</label><input asp-for="Password" class="form-control"/><small class="text-muted">Use a strong temporary password; user should change it after handover.</small></div>}<div class="form-check form-switch align-self-end mb-2"><input asp-for="IsActive" class="form-check-input"/><label asp-for="IsActive" class="form-check-label">Account Active</label></div></div><div class="mt-4"><label class="form-label fw-semibold">Department Data Scope</label><p class="text-muted small">Users without “Data.AllDepartments” can only access jobs assigned to these departments.</p><div class="department-checks">@foreach(var d in Model.Departments){var did=int.Parse(d.Value);<label><input type="checkbox" name="DepartmentIds" value="@d.Value" checked="@Model.DepartmentIds.Contains(did)"/> @d.Text</label>}</div></div><div class="form-actions"><a class="btn btn-light" asp-action="Index">Cancel</a><button class="btn btn-primary">@(edit?"Save User":"Create User")</button></div></section></form>
