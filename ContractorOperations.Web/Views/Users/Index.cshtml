@model List<UserListVm>
@{ ViewData["Title"]="Users"; }
<div class="page-heading"><div><h1>Users</h1><p>Manage accounts, roles, departments and individual permission overrides.</p></div><a class="btn btn-primary" asp-action="Create"><i class="bi bi-person-plus"></i> Add User</a></div>
<section class="panel"><div class="table-responsive"><table class="table align-middle"><thead><tr><th>User</th><th>Role</th><th>Departments</th><th>Status</th><th>Actions</th></tr></thead><tbody>@foreach(var x in Model){<tr><td><strong>@x.User.FullName</strong><small class="d-block text-muted">@x.User.Email</small></td><td>@x.Roles</td><td>@(string.IsNullOrWhiteSpace(x.Departments)?"Not assigned":x.Departments)</td><td><span class="stock-state @(x.User.IsActive?"ok":"out")">@(x.User.IsActive?"Active":"Inactive")</span></td><td class="actions"><a asp-action="Edit" asp-route-id="@x.User.Id" title="Edit"><i class="bi bi-pencil"></i></a><a asp-controller="Permissions" asp-action="UserAccess" asp-route-id="@x.User.Id" title="Granular permissions"><i class="bi bi-shield-lock"></i></a><form asp-action="ResetPassword" asp-route-id="@x.User.Id" method="post" class="d-inline" onsubmit="return confirm('Reset this user password?');"><button class="btn btn-link p-0" title="Reset password"><i class="bi bi-key"></i></button></form></td></tr>}</tbody></table></div></section>
