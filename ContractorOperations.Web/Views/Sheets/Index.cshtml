@model SheetIndexVm
@inject IPermissionService PermissionService
@{
    ViewData["Title"] = "Service Operations";
    var canManage = await PermissionService.HasPermissionAsync(User, "Sheets.Manage");
    var selectedProject = Context.Request.Query["projectId"].ToString();
    var selectedDepartment = Context.Request.Query["departmentId"].ToString();
    var workflowNames = new[] { "Requisition", "Service Business", "Purchase Order", "Service Logistics", "Invoice Reception" };
    var workflowSheets = Model.Sheets.Where(x => workflowNames.Contains(x.Name, StringComparer.OrdinalIgnoreCase))
        .OrderBy(x => x.Project?.Name)
        .ThenBy(x => Array.FindIndex(workflowNames, n => n.Equals(x.Name, StringComparison.OrdinalIgnoreCase)))
        .ToList();
    var otherSheets = Model.Sheets.Where(x => !workflowNames.Contains(x.Name, StringComparer.OrdinalIgnoreCase)
        && !x.Name.Equals("Requisition Approval", StringComparison.OrdinalIgnoreCase)
        && !x.Name.Equals("Service Approval", StringComparison.OrdinalIgnoreCase)).ToList();
    var workflowDescriptions = new Dictionary<string,string>(StringComparer.OrdinalIgnoreCase)
    {
        ["Requisition"] = "Create the requisition with all items, send it to the responsible manager, then wait for Accept or Reject.",
        ["Service Business"] = "Create the service job only after the requisition and Service Approval requirements are complete.",
        ["Purchase Order"] = "Create and issue the PO to the vendor.",
        ["Service Logistics"] = "Track local delivery or international export/import through equipment return.",
        ["Invoice Reception"] = "Receive invoice and follow payment until closure."
    };
}

<div class="page-heading">
    <div><h1>Service Operations</h1><p>Manage service requisitions, approvals, jobs, purchase orders, logistics, and invoice closure from one controlled workspace.</p></div>
    @if (canManage) { <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addSheetModal"><i class="bi bi-plus-lg"></i> New Sheet</button> }
</div>

<section class="panel mb-3">
    <form method="get" class="form-grid-3 align-items-end">
        <div><label class="form-label">Project</label><select class="form-select" name="projectId"><option value="">All Projects</option>@foreach(var p in Model.Projects){if(selectedProject==p.Id.ToString()){<option value="@p.Id" selected>@p.Name</option>}else{<option value="@p.Id">@p.Name</option>}}</select></div>
        <div><label class="form-label">Department</label><select class="form-select" name="departmentId"><option value="">All Departments</option>@foreach(var d in Model.Departments){if(selectedDepartment==d.Id.ToString()){<option value="@d.Id" selected>@d.Name</option>}else{<option value="@d.Id">@d.Name</option>}}</select></div>
        <div><button class="btn btn-outline-primary"><i class="bi bi-funnel"></i> Filter</button> <a class="btn btn-light border" asp-action="Index">Clear</a></div>
    </form>
</section>

<section class="panel mb-3">
    <div class="panel-head"><div><h3>Service Procurement &amp; Job Lifecycle</h3><p>The order is controlled: Requisition first, then Service Approval, then Job Creation and the downstream commercial process.</p></div></div>
    <div class="workflow-mini-flow mb-3">
        <span>1. Requisition</span><i class="bi bi-arrow-right"></i><span>2. Service Approval</span><i class="bi bi-arrow-right"></i><span>3. Job Creation</span><i class="bi bi-arrow-right"></i><span>4. Purchase Order</span><i class="bi bi-arrow-right"></i><span>5. Logistics &amp; Return</span><i class="bi bi-arrow-right"></i><span>6. Invoice &amp; Payment</span>
    </div>
    <div class="workflow-step-grid workflow-step-grid-wide">
    @foreach (var sheet in workflowSheets.Where(x => x.Name.Equals("Requisition", StringComparison.OrdinalIgnoreCase)))
    {
        <a class="workflow-step-card" asp-action="Details" asp-route-id="@sheet.Id">
            <span class="workflow-step-no">1</span>
            <div><strong>Requisition</strong><small>@workflowDescriptions["Requisition"]</small><em>@(sheet.Project != null ? sheet.Project.Name : sheet.Department?.Name ?? "General")</em></div>
            <i class="bi bi-arrow-right"></i>
        </a>
    }
        <a class="workflow-step-card" asp-controller="ServiceApprovals" asp-action="Index" asp-route-projectId="@selectedProject">
            <span class="workflow-step-no">2</span>
            <div><strong>Service Approval</strong><small>Available only after a requisition is accepted. It stays Waiting Approval until its required signatures/decisions are complete.</small><em>Open Service Approval register</em></div>
            <i class="bi bi-arrow-right"></i>
        </a>
    @foreach (var sheet in workflowSheets.Where(x => !x.Name.Equals("Requisition", StringComparison.OrdinalIgnoreCase)))
    {
        var baseStep = Array.FindIndex(workflowNames, x => x.Equals(sheet.Name, StringComparison.OrdinalIgnoreCase));
        var stepNo = baseStep + 2;
        var label = sheet.Name == "Service Business" ? "Job Creation" : sheet.Name == "Service Logistics" ? "Logistics & Return" : sheet.Name == "Invoice Reception" ? "Invoice & Payment" : sheet.Name;
        <a class="workflow-step-card" asp-action="Details" asp-route-id="@sheet.Id">
            <span class="workflow-step-no">@stepNo</span>
            <div><strong>@label</strong><small>@workflowDescriptions.GetValueOrDefault(sheet.Name)</small><em>@(sheet.Project != null ? sheet.Project.Name : sheet.Department?.Name ?? "General")</em></div>
            <i class="bi bi-arrow-right"></i>
        </a>
    }
    </div>
</section>

<section class="panel">
    <div class="panel-head"><div><h3>Other Sheets</h3><p>Supporting operational records that are not part of the core service lifecycle.</p></div></div>
    <div class="sheet-card-grid">
    @foreach (var sheet in otherSheets)
    {
        <a class="sheet-card" asp-action="Details" asp-route-id="@sheet.Id">
            <div class="sheet-card-top"><span class="sheet-icon"><i class="bi bi-table"></i></span><span class="sheet-id">@sheet.UniqueId</span></div>
            <h4>@sheet.Name</h4>
            <p>@(sheet.Project != null ? $"Project: {sheet.Project.Name}" : sheet.Department != null ? $"Department: {sheet.Department.Name}" : "General sheet")</p>
            <span class="sheet-open">Open Sheet <i class="bi bi-arrow-right"></i></span>
        </a>
    }
    @if (!otherSheets.Any()) { <div class="text-muted py-3">No other sheets found.</div> }
    </div>
</section>

@if (!Model.Sheets.Any())
{
    <section class="panel empty-state"><i class="bi bi-table"></i><h3>No sheets found</h3><p>Create a project or department sheet to start recording data.</p></section>
}

@if (canManage)
{
<div class="modal fade" id="addSheetModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content border-0 shadow">
        <div class="modal-header"><h5 class="modal-title">Create Operational Sheet</h5><button class="btn-close" data-bs-dismiss="modal"></button></div>
        <form asp-action="Create" method="post">
            <div class="modal-body">
                <div class="mb-3"><label class="form-label">Sheet Name</label><input class="form-control" name="name" placeholder="e.g. Expense Sheet" required /></div>
                <div class="mb-3"><label class="form-label">Project (optional)</label><select class="form-select" name="projectId"><option value="">-- None --</option>@foreach(var p in Model.Projects){<option value="@p.Id">@p.Name</option>}</select></div>
                <div><label class="form-label">Department (optional)</label><select class="form-select" name="departmentId"><option value="">-- None --</option>@foreach(var d in Model.Departments){<option value="@d.Id">@d.Name</option>}</select><small class="text-muted">Choose at least one project or department.</small></div>
            </div>
            <div class="modal-footer"><button class="btn btn-light border" type="button" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary">Create Sheet</button></div>
        </form>
    </div></div>
</div>
}
