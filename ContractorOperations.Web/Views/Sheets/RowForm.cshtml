@model SheetRowFormVm
@{
    var editing = Model.Row != null;
    var isRequisition = Model.Sheet.Name.Equals("Requisition", StringComparison.OrdinalIgnoreCase);
    var isServiceBusiness = Model.Sheet.Name.Equals("Service Business", StringComparison.OrdinalIgnoreCase);
    var isServiceApproval = Model.Sheet.Name.Equals("Service Approval", StringComparison.OrdinalIgnoreCase);
    var displaySheetName = Model.Sheet.Name == "Requisition" ? "Service Requisition"
        : isServiceApproval ? "Manager Approval"
        : Model.Sheet.Name == "Service Business" ? "Job Creation"
        : Model.Sheet.Name == "Service Logistics" ? "Logistics & Return"
        : Model.Sheet.Name == "Invoice Reception" ? "Invoice & Payment"
        : Model.Sheet.Name;
    var requisitionNoColumn = Model.Columns.FirstOrDefault(x => x.Name.Equals("Requisition No", StringComparison.OrdinalIgnoreCase));
    var activeRequisitionNo = requisitionNoColumn != null && Model.Values.TryGetValue(requisitionNoColumn.Id, out var reqNoValue) ? reqNoValue : null;
    var addingRequisitionItem = isRequisition && !editing && !string.IsNullOrWhiteSpace(activeRequisitionNo);
    var addLabel = isRequisition ? (addingRequisitionItem ? "Add Item" : "Add Req") : isServiceBusiness ? "Add Job" : isServiceApproval ? "Submit for Approval" : "Add Job";
    ViewData["Title"] = editing ? $"Edit {Model.Row!.UniqueId}" : $"{addLabel} - {displaySheetName}";
    var localAbroadCol = Model.Columns.FirstOrDefault(x => x.Name.Equals("Local/Abroad", StringComparison.OrdinalIgnoreCase));
    var logisticsModeCol = Model.Sheet.Name.Equals("Service Logistics", StringComparison.OrdinalIgnoreCase) ? Model.Columns.FirstOrDefault(x => x.Name.Equals("Mode", StringComparison.OrdinalIgnoreCase)) : null;
    var exportJobCol = Model.Columns.FirstOrDefault(x => x.Name.Equals("Export Job No", StringComparison.OrdinalIgnoreCase));
    var importJobCol = Model.Columns.FirstOrDefault(x => x.Name.Equals("Import Job No", StringComparison.OrdinalIgnoreCase));
    var isPurchaseOrder = Model.Sheet.Name.Equals("Purchase Order", StringComparison.OrdinalIgnoreCase);
    var isServiceLogistics = Model.Sheet.Name.Equals("Service Logistics", StringComparison.OrdinalIgnoreCase);
    var isInvoiceReception = Model.Sheet.Name.Equals("Invoice Reception", StringComparison.OrdinalIgnoreCase);
}

<div class="page-heading">
    <div>
        <a class="workspace-back" asp-action="Details" asp-route-id="@Model.Sheet.Id"><i class="bi bi-arrow-left"></i> @displaySheetName</a>
        <h1>@(editing ? $"Edit {Model.Row!.UniqueId}" : addLabel)</h1>
        <p>@Model.Sheet.UniqueId · Values are stored inside this sheet only.</p>
    </div>
</div>

<section class="panel sheet-row-form-panel">
    @if (isServiceApproval)
    {
        <div class="workflow-form-notice approval-notice">
            <i class="bi bi-person-check-fill"></i>
            <div><strong>Manager Approval</strong><span>Submit the linked requisition to the responsible PM/manager for a formal decision. The assigned approver receives a notification and must approve or reject the request before Job Creation can continue.</span></div>
        </div>
    }
    else if (isRequisition)
    {
        <div class="workflow-form-notice"><i class="bi bi-file-earmark-text"></i><div><strong>Step 1 · @(addingRequisitionItem ? $"Add item to {activeRequisitionNo}" : "New requisition")</strong><span>@(addingRequisitionItem ? "This line will stay under the same requisition number and department. Item No is assigned automatically." : "Choose the request department and enter the first item. The system creates a new department-wise requisition number; use Add Item afterwards for more lines under the same requisition.")</span></div></div>
    }
    else if (isServiceBusiness)
    {
        <div class="workflow-form-notice"><i class="bi bi-briefcase-fill"></i><div><strong>Step 3 · Job Creation</strong><span>Select the approved requisition and its Manager Approval. On save, every requisition line item is copied automatically into the service job under one shared Job Number.</span></div></div>
    }
    else if (isPurchaseOrder)
    {
        <div class="workflow-form-notice"><i class="bi bi-receipt"></i><div><strong>Step 4 · Purchase Order</strong><span>Create the vendor PO against an approved service job and record quotation/terms.</span></div></div>
    }
    else if (isServiceLogistics)
    {
        <div class="workflow-form-notice"><i class="bi bi-truck"></i><div><strong>Step 5 · Logistics & Return</strong><span>Track local delivery or international export, follow-up, received-back date and import reference.</span></div></div>
    }
    else if (isInvoiceReception)
    {
        <div class="workflow-form-notice"><i class="bi bi-cash-stack"></i><div><strong>Step 6 · Invoice & Payment Follow-up</strong><span>Invoice reception starts after the equipment/service is received back. Duplicate invoice numbers are blocked across BGP.</span></div></div>
    }
    <form asp-action="@(editing ? "EditRowPost" : "AddRowPost")" method="post" enctype="multipart/form-data">
        @if (editing) { <input type="hidden" name="id" value="@Model.Row!.Id"/> } else { <input type="hidden" name="sheetId" value="@Model.Sheet.Id"/> }
        <div asp-validation-summary="All" class="text-danger mb-3"></div>
        <div class="dynamic-form-grid">
        @foreach (var col in Model.Columns)
        {
            Model.Values.TryGetValue(col.Id, out var value);
            var fieldName = $"col_{col.Id}";
            var isAuto = !string.IsNullOrWhiteSpace(col.Options) && col.Options.StartsWith("__AUTO_", StringComparison.OrdinalIgnoreCase);
            var isComputed = !string.IsNullOrWhiteSpace(col.Options) && col.Options.StartsWith("__COMPUTED_", StringComparison.OrdinalIgnoreCase);
            var fieldId = $"sheet_col_{col.Id}";
            <div class="dynamic-field @(col.ColumnType == SheetColumnType.Text && Model.Columns.Count < 8 ? "wide" : "")" data-column-name="@col.Name">
                <label class="form-label">@col.Name @if(col.IsRequired){<span class="text-danger">*</span>} <small>@col.ColumnType</small></label>
                @if (isAuto || isComputed)
                {
                    <input id="@fieldId" class="form-control system-managed-field" type="text" name="@fieldName" value="@value" readonly placeholder="@(isAuto ? "Auto-generated on save" : "Calculated automatically")" />
                    <small class="text-muted">@(isAuto ? "System-generated unique value." : "Calculated automatically from linked sheet data.")</small>
                }
                else if (col.Options == "__APPROVAL_MANAGERS__")
                {
                    <select id="@fieldId" class="form-select" name="@fieldName">
                        <option value="">-- Select responsible manager --</option>
                        @foreach (var manager in Model.ApprovalManagers)
                        {
                            var managerValue = manager.Email ?? manager.UserName ?? manager.Id;
                            var managerLabel = string.IsNullOrWhiteSpace(manager.FullName) ? managerValue : $"{manager.FullName} · {managerValue}";
                            if (string.Equals(managerValue, value, StringComparison.OrdinalIgnoreCase)) { <option selected value="@managerValue">@managerLabel</option> }
                            else { <option value="@managerValue">@managerLabel</option> }
                        }
                    </select>
                    <small class="text-muted">This manager receives the approval notification and is responsible for the decision.</small>
                }
                else if (!string.IsNullOrWhiteSpace(col.Options) && Model.ReferenceOptions.TryGetValue(col.Options, out var referenceValues))
                {
                    <select id="@fieldId" class="form-select" name="@fieldName">
                        <option value="">-- Select @col.Name --</option>
                        @if (!string.IsNullOrWhiteSpace(value) && !referenceValues.Contains(value, StringComparer.OrdinalIgnoreCase))
                        {
                            <option selected value="@value">@value</option>
                        }
                        @foreach (var option in referenceValues)
                        {
                            if (string.Equals(option, value, StringComparison.OrdinalIgnoreCase)) { <option selected value="@option">@option</option> }
                            else { <option value="@option">@option</option> }
                        }
                    </select>
                    @if (!referenceValues.Any()) { <small class="text-warning">No eligible records are available from the previous workflow step yet.</small> }
                }
                else if (col.Options == "__DEPARTMENTS__")
                {
                    @if (addingRequisitionItem && col.Name.Equals("Request Department", StringComparison.OrdinalIgnoreCase))
                    {
                        var lockedDepartment = Model.Departments.FirstOrDefault(x => string.Equals(x.Code, value, StringComparison.OrdinalIgnoreCase));
                        <input id="@fieldId" class="form-control" value="@(lockedDepartment == null ? value : $"{lockedDepartment.Code} - {lockedDepartment.Name}")" readonly />
                        <input type="hidden" name="@fieldName" value="@value" />
                        <small class="text-muted">Department is locked to this requisition.</small>
                    }
                    else
                    {
                        <select id="@fieldId" class="form-select" name="@fieldName">
                            <option value="">-- Select department --</option>
                            @foreach (var department in Model.Departments)
                            {
                                if (department.Code == value) { <option selected value="@department.Code">@department.Code - @department.Name</option> }
                                else { <option value="@department.Code">@department.Code - @department.Name</option> }
                            }
                        </select>
                    }
                }
                else if (col.Options == "__CURRENCIES__")
                {
                    <select id="@fieldId" class="form-select" name="@fieldName">
                        <option value="">-- Select currency --</option>
                        @foreach (var currency in Model.Currencies)
                        {
                            if (currency.Code == value) { <option selected value="@currency.Code">@currency.Code - @currency.Name</option> }
                            else { <option value="@currency.Code">@currency.Code - @currency.Name</option> }
                        }
                    </select>
                }
                else if (col.ColumnType == SheetColumnType.Project || col.Options == "__PROJECTS__")
                {
                    <select id="@fieldId" class="form-select" name="@fieldName">
                        <option value="">-- Select project --</option>
                        @foreach (var project in Model.Projects)
                        {
                            if (project.Code == value || project.Name == value) { <option selected value="@project.Code">@project.Code - @project.Name</option> }
                            else { <option value="@project.Code">@project.Code - @project.Name</option> }
                        }
                    </select>
                }
                else if (col.ColumnType == SheetColumnType.Date)
                {
                    <input id="@fieldId" class="form-control" type="date" name="@fieldName" value="@value" />
                }
                else if (col.ColumnType == SheetColumnType.Time)
                {
                    <input id="@fieldId" class="form-control" type="time" name="@fieldName" value="@value" />
                }
                else if (col.ColumnType == SheetColumnType.Number || col.ColumnType == SheetColumnType.Currency || col.ColumnType == SheetColumnType.Percentage)
                {
                    <input id="@fieldId" class="form-control" type="number" step="any" name="@fieldName" value="@value" />
                }
                else if (col.ColumnType == SheetColumnType.Email)
                {
                    <input id="@fieldId" class="form-control" type="email" name="@fieldName" value="@value" />
                }
                else if (col.ColumnType == SheetColumnType.Phone)
                {
                    <input id="@fieldId" class="form-control" type="tel" name="@fieldName" value="@value" />
                }
                else if (col.ColumnType == SheetColumnType.Checkbox)
                {
                    var isChecked = string.Equals(value,"true",StringComparison.OrdinalIgnoreCase) || string.Equals(value,"on",StringComparison.OrdinalIgnoreCase);
                    <div class="form-check dynamic-check">
                    @if(isChecked){<input id="@fieldId" class="form-check-input" type="checkbox" name="@fieldName" value="true" checked/>}else{<input id="@fieldId" class="form-check-input" type="checkbox" name="@fieldName" value="true"/>}
                    <label class="form-check-label" for="@fieldId">Yes / checked</label></div>
                }
                else if (col.ColumnType == SheetColumnType.Dropdown || col.ColumnType == SheetColumnType.Status)
                {
                    var rawOptions = string.IsNullOrWhiteSpace(col.Options) && col.ColumnType == SheetColumnType.Status ? "Pending,In Progress,Completed,On Hold,Cancelled" : col.Options ?? "";
                    var options = rawOptions.Split(new[]{',','\n','|'}, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
                    <select id="@fieldId" class="form-select" name="@fieldName"><option value="">-- Select --</option>@foreach(var option in options){if(option==value){<option selected value="@option">@option</option>}else{<option value="@option">@option</option>}}</select>
                }
                else if (col.ColumnType == SheetColumnType.File)
                {
                    @if(!string.IsNullOrWhiteSpace(value)){<div class="mb-2"><a href="@value" target="_blank"><i class="bi bi-paperclip"></i> Current file</a></div>}
                    <input id="@fieldId" class="form-control" type="file" name="@fieldName" />
                }
                else
                {
                    <input id="@fieldId" class="form-control" type="text" name="@fieldName" value="@value" />
                }
            </div>
        }
        </div>
        @if (!Model.Columns.Any())
        {
            <div class="alert alert-warning">This sheet is intentionally empty. Add the columns you need from Column Management before creating records.</div>
        }
        <div class="form-actions mt-4"><a class="btn btn-light border" asp-action="Details" asp-route-id="@Model.Sheet.Id">Cancel</a>@if(Model.Columns.Any()){<button class="btn btn-primary"><i class="bi bi-check2"></i> @(editing ? "Save Changes" : addLabel)</button>}else{<button class="btn btn-primary" type="button" disabled><i class="bi bi-check2"></i> @addLabel</button>}</div>
    </form>
</section>

@if ((localAbroadCol != null || logisticsModeCol != null) && exportJobCol != null && importJobCol != null)
{
    var localSelectorId = localAbroadCol?.Id ?? logisticsModeCol!.Id;
<script>
(function () {
    const selector = document.getElementById('sheet_col_@localSelectorId');
    const exportField = document.querySelector('[data-column-name="Export Job No"]');
    const importField = document.querySelector('[data-column-name="Import Job No"]');
    function updateVisibility() {
        const local = selector && selector.value.toLowerCase() === 'local';
        [exportField, importField].forEach(field => {
            if (!field) return;
            field.style.display = local ? 'none' : '';
            if (local) {
                const input = field.querySelector('input,select,textarea');
                if (input) input.value = '';
            }
        });
    }
    if (selector) selector.addEventListener('change', updateVisibility);
    updateVisibility();
})();
</script>
}

