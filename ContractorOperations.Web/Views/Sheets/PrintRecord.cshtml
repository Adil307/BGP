@model SheetDetailsVm
@{
    Layout = null;
    var row = Model.Rows.FirstOrDefault();
    var title = Model.Sheet.Name == "Requisition" ? "Requisition Item" : Model.Sheet.Name;
}
<!doctype html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title @(row?.UniqueId)</title>
    <style>
        *{box-sizing:border-box}body{margin:0;background:#eef1f5;color:#182230;font-family:Arial,Helvetica,sans-serif;font-size:12px}.toolbar{max-width:820px;margin:18px auto 0;text-align:right}.toolbar button{border:1px solid #cbd5e1;background:#fff;border-radius:6px;padding:8px 13px;font-weight:700;cursor:pointer}.page{width:min(820px,calc(100% - 32px));margin:12px auto 30px;background:#fff;padding:28px 32px;box-shadow:0 2px 14px rgba(0,0,0,.08)}.head{display:grid;grid-template-columns:85px 1fr auto;gap:14px;align-items:center;border-bottom:2px solid #26384d;padding-bottom:14px}.logo{width:78px;max-height:58px;object-fit:contain}h1{margin:0;font-size:20px}.sub{color:#66758a;margin-top:4px}.record-id{text-align:right;font-weight:700}.fields{margin-top:18px;border:1px solid #d8dee7}.field{display:grid;grid-template-columns:220px 1fr;border-bottom:1px solid #d8dee7}.field:last-child{border-bottom:0}.field .name{background:#f4f6f8;padding:9px 10px;font-weight:700}.field .value{padding:9px 10px;overflow-wrap:anywhere}.foot{margin-top:22px;padding-top:9px;border-top:1px solid #d8dee7;color:#738094;font-size:9px;display:flex;justify-content:space-between}@@media(max-width:600px){.page{width:100%;margin:0;box-shadow:none;padding:18px}.head{grid-template-columns:65px 1fr}.record-id{grid-column:1/-1;text-align:left}.field{grid-template-columns:1fr}.field .name{padding-bottom:4px}}@@media print{@@page{size:A4 portrait;margin:12mm}body{background:#fff}.no-print{display:none!important}.page{width:auto;margin:0;padding:0;box-shadow:none}.field{break-inside:avoid}}
    </style>
</head>
<body>
<div class="toolbar no-print"><button type="button" onclick="window.print()">Print / Save PDF</button></div>
<main class="page">
    <header class="head">
        <img class="logo" src="/images/bgp-logo.jpeg" alt="BGP" />
        <div><h1>@title</h1><div class="sub">@(Model.Sheet.Project?.Name ?? Model.Sheet.Department?.Name ?? "BGP Contractor Operations")</div></div>
        <div class="record-id">@(row?.UniqueId ?? "Record")</div>
    </header>
    @if (row != null)
    {
        <section class="fields">
        @foreach (var col in Model.Columns)
        {
            var value = row.Cells.FirstOrDefault(x => x.SheetColumnId == col.Id)?.Value;
            <div class="field"><div class="name">@col.Name</div><div class="value">@(string.IsNullOrWhiteSpace(value) ? "—" : value)</div></div>
        }
        </section>
    }
    <footer class="foot"><span>BGP Contractor Operations System</span><span>Printed @DateTime.Now.ToString("dd MMM yyyy HH:mm")</span></footer>
</main>
</body>
</html>
