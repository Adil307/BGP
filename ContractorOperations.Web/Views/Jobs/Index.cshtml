@model List<Job>
@{ ViewData["Title"]="Jobs"; }
<div class="page-heading"><div><h1>Jobs</h1><p>Search, review and manage contractor job records.</p></div><div class="page-actions"><a class="btn btn-outline-secondary" asp-action="RecycleBin"><i class="bi bi-trash3"></i> Recycle Bin</a><a class="btn btn-outline-secondary" asp-action="ExportCsv"><i class="bi bi-download"></i> Export CSV</a><a class="btn btn-primary" asp-controller="Sheets" asp-action="Index"><i class="bi bi-plus-lg"></i> Add Job</a></div></div>
<section class="panel filter-panel"><form method="get" class="filter-grid"><input class="form-control" name="q" value="@ViewBag.Query" placeholder="Job no., description or contractor"/><select class="form-select" name="projectId"><option value="">All projects</option>@foreach(var x in (SelectList)ViewBag.Projects){<option value="@x.Value" selected="@x.Selected">@x.Text</option>}</select><select class="form-select" name="departmentId"><option value="">All departments</option>@foreach(var x in (SelectList)ViewBag.Departments){<option value="@x.Value" selected="@x.Selected">@x.Text</option>}</select><select class="form-select" name="contractorId"><option value="">All contractors</option>@foreach(var x in (SelectList)ViewBag.Contractors){<option value="@x.Value" selected="@x.Selected">@x.Text</option>}</select><select class="form-select" name="status"><option value="">All statuses</option>@foreach(var s in Enum.GetValues<JobStatus>()){<option value="@s" selected="@(ViewBag.Status?.ToString()==s.ToString())">@s</option>}</select><input class="form-control" type="date" name="from" value="@(ViewBag.From?.ToString("yyyy-MM-dd"))"/><input class="form-control" type="date" name="to" value="@(ViewBag.To?.ToString("yyyy-MM-dd"))"/><button class="btn btn-primary">Filter</button></form></section>
<section class="panel mt-3"><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Job No.</th><th>Date</th><th>Project</th><th>Department</th><th>Contractor</th><th>Description</th><th>Qty</th><th>Amount</th><th>Status</th><th>Acceptance</th><th>Payment</th><th>Action</th></tr></thead><tbody>
@foreach(var j in Model){var totals=string.Join(" / ",j.Lines.GroupBy(x=>x.Currency?.Code??"").Select(g=>$"{g.Key} {g.Sum(x=>x.Total):N2}"));<tr><td><strong>@j.JobNumber</strong></td><td>@j.JobDate.ToString("dd MMM yyyy")</td><td>@j.Project?.Name</td><td>@j.Department?.Name</td><td>@j.Contractor?.Name</td><td class="text-wrap-cell">@j.Description</td><td>@j.Lines.Sum(x=>x.Quantity).ToString("N3")</td><td>@totals</td><td><span class="status @j.Status.ToString().ToLowerInvariant()">@j.Status</span></td><td>@if(j.IsAccepted){<span class="status approved">Accepted</span>}else{<span class="text-muted small">Pending</span>}</td><td>@j.PaymentStatus</td><td class="actions"><a asp-action="Details" asp-route-id="@j.Id" title="View"><i class="bi bi-eye"></i></a><a asp-action="Edit" asp-route-id="@j.Id" title="Edit"><i class="bi bi-pencil"></i></a></td></tr>}
@if(Model.Count==0){<tr><td colspan="12" class="empty-row">No jobs found.</td></tr>}</tbody></table></div></section>
