@model List<Job>
@{ ViewData["Title"]="Job Recycle Bin"; }
<div class="page-heading"><div><h1>Job Recycle Bin</h1><p>Deleted jobs are retained here and can be restored by authorized users.</p></div><a class="btn btn-outline-secondary" asp-action="Index">Back to Jobs</a></div>
<section class="panel"><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Job No.</th><th>Project</th><th>Department</th><th>Contractor</th><th>Description</th><th>Deleted</th><th>Action</th></tr></thead><tbody>@foreach(var j in Model){<tr><td><strong>@j.JobNumber</strong></td><td>@j.Project?.Name</td><td>@j.Department?.Name</td><td>@j.Contractor?.Name</td><td>@j.Description</td><td>@j.DeletedAt?.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td><td><form asp-action="Restore" asp-route-id="@j.Id" method="post"><button class="btn btn-sm btn-outline-success"><i class="bi bi-arrow-counterclockwise"></i> Restore</button></form></td></tr>}@if(!Model.Any()){<tr><td colspan="7" class="empty-row">Recycle bin is empty.</td></tr>}</tbody></table></div></section>
