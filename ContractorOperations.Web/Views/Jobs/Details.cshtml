@model Job
@inject IPermissionService PermissionService
@{
    ViewData["Title"]=$"Job {Model.JobNumber}";
    var currencyTotals=Model.Lines.GroupBy(x=>x.Currency?.Code??"").ToDictionary(g=>g.Key,g=>g.Sum(x=>x.Total));
    var canEdit=await PermissionService.HasPermissionAsync(User,"Jobs.Edit");
    var canDelete=await PermissionService.HasPermissionAsync(User,"Jobs.Delete");
    var canAccept=await PermissionService.HasPermissionAsync(User,"Jobs.Accept");
    var canCancel=await PermissionService.HasPermissionAsync(User,"Jobs.Cancel");
    var canGenerateDocument=await PermissionService.HasPermissionAsync(User,"Documents.Generate");
}
<div class="page-heading"><div><h1>@Model.JobNumber</h1><p>@Model.Project?.Name · @Model.Department?.Name · @Model.Contractor?.Name</p></div><div class="page-actions no-print"><a class="btn btn-outline-secondary" asp-controller="Documents" asp-action="Record" asp-route-referenceType="Job" asp-route-referenceId="@Model.Id"><i class="bi bi-folder2-open"></i> Documents</a>@if(canGenerateDocument){<a class="btn btn-outline-primary" asp-controller="CompanyDocuments" asp-action="Create" asp-route-jobId="@Model.Id"><i class="bi bi-file-earmark-richtext"></i> Company Document</a>}<button class="btn btn-outline-secondary" type="button" onclick="window.print()"><i class="bi bi-printer"></i> Print</button>@if(canEdit && Model.Status!=JobStatus.Cancelled){<a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id"><i class="bi bi-pencil"></i> Edit</a>}<a class="btn btn-outline-secondary" asp-action="Index">Back</a></div></div>
@if(Model.IsAccepted){<div class="workflow-context-card"><div class="workflow-context-icon"><i class="bi bi-shield-check"></i></div><div><strong>Accepted Job · Protected Business Record</strong><p>This job can no longer be deleted. If work must stop, use <b>Cancel Job</b> and record the reason; all documents and history remain available.</p></div></div>}
@if(Model.Status==JobStatus.Cancelled){<div class="alert alert-danger"><strong>Job Cancelled</strong><br/>Reason: @Model.CancellationReason@if(!string.IsNullOrWhiteSpace(Model.CancellationNotes)){<br/><span>@Model.CancellationNotes</span>}<br/><small>Cancelled @Model.CancelledAt?.ToLocalTime().ToString("dd MMM yyyy HH:mm") · Previous status: @Model.PreviousStatus</small></div>}
<div class="dashboard-grid-2"><section class="panel"><h3>Job Information</h3><dl class="detail-grid"><dt>Description</dt><dd>@Model.Description</dd><dt>Job Date</dt><dd>@Model.JobDate.ToString("dd MMM yyyy")</dd><dt>Status</dt><dd><span class="status @Model.Status.ToString().ToLowerInvariant()">@Model.Status</span></dd><dt>Acceptance</dt><dd>@(Model.IsAccepted?"Accepted":"Not accepted") @if(Model.AcceptedAt.HasValue){<small>· @Model.AcceptedAt.Value.ToLocalTime().ToString("dd MMM yyyy HH:mm")</small>}</dd><dt>Service</dt><dd>@(Model.ServiceStart?.ToString("dd MMM yyyy")??"-") → @(Model.ServiceEnd?.ToString("dd MMM yyyy")??"-")</dd><dt>Created By</dt><dd>@Model.CreatedByUser?.FullName</dd><dt>Created</dt><dd>@Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</dd></dl></section><section class="panel"><h3>Invoice & Payment</h3><dl class="detail-grid"><dt>Invoice No.</dt><dd>@(Model.InvoiceNumber??"-")</dd><dt>Invoice Date</dt><dd>@(Model.InvoiceDate?.ToString("dd MMM yyyy")??"-")</dd><dt>Payment</dt><dd>@Model.PaymentStatus</dd><dt>Processor</dt><dd>@(Model.ProcessorName??"-")</dd>@foreach(var t in currencyTotals){<dt>@t.Key Total</dt><dd><strong>@t.Value.ToString("N2")</strong></dd>}</dl></section></div>
<section class="panel mt-3"><h3>Line Items</h3><div class="table-responsive"><table class="table"><thead><tr><th>Item Serial No.</th><th>Description</th><th>Unit</th><th>Qty</th><th>Rate</th><th>Currency</th><th>Total</th></tr></thead><tbody>@foreach(var x in Model.Lines){<tr><td><strong>@(x.ItemSerialNumber??"-")</strong></td><td>@x.Description</td><td>@x.Unit?.Code</td><td>@x.Quantity.ToString("N3")</td><td>@x.UnitRate.ToString("N2")</td><td>@x.Currency?.Code</td><td><strong>@x.Total.ToString("N2")</strong></td></tr>}</tbody></table></div></section>
@if(!Model.IsAccepted && Model.Status!=JobStatus.Cancelled && canAccept){<section class="panel mt-3 no-print"><h3>Accept Job</h3><p>Acceptance makes the job a protected business record. It can be cancelled later with a reason, but it cannot be deleted.</p><form asp-action="Accept" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Accept this job and protect it from deletion?');"><button class="btn btn-success"><i class="bi bi-check2-circle"></i> Accept Job</button></form></section>}
@if(Model.IsAccepted && Model.Status!=JobStatus.Cancelled && canCancel){<section class="panel mt-3 danger-zone no-print"><h3>Cancel Job</h3><p>Cancellation preserves the job number, requisitions, items, documents and audit history.</p><form asp-action="Cancel" asp-route-id="@Model.Id" method="post"><div class="form-grid-2"><div><label class="form-label">Cancellation Reason *</label><textarea class="form-control" name="cancellationReason" rows="3" required></textarea></div><div><label class="form-label">Additional Notes</label><textarea class="form-control" name="cancellationNotes" rows="3"></textarea></div></div><div class="form-actions"><button class="btn btn-outline-danger" onclick="return confirm('Cancel this accepted job? The record will remain in BGP.');"><i class="bi bi-x-octagon"></i> Cancel Job</button></div></form></section>}
@if(!Model.IsAccepted && Model.Status!=JobStatus.Cancelled && canDelete){<section class="panel mt-3 danger-zone no-print"><h3>Delete Draft / Unaccepted Job</h3><p>Only unaccepted jobs can be moved to the recycle bin.</p><form asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Move this unaccepted job to the recycle bin?');"><button class="btn btn-outline-danger"><i class="bi bi-trash"></i> Delete Job</button></form></section>}
