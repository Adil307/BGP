@model Job
@{ ViewData["Title"]=$"Job {Model.JobNumber}"; var currencyTotals=Model.Lines.GroupBy(x=>x.Currency?.Code??"").ToDictionary(g=>g.Key,g=>g.Sum(x=>x.Total)); }
<div class="page-heading"><div><h1>@Model.JobNumber</h1><p>@Model.Project?.Name · @Model.Department?.Name · @Model.Contractor?.Name</p></div><div class="page-actions"><a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id"><i class="bi bi-pencil"></i> Edit</a><a class="btn btn-outline-secondary" asp-action="Index">Back</a></div></div>
<div class="dashboard-grid-2"><section class="panel"><h3>Job Information</h3><dl class="detail-grid"><dt>Description</dt><dd>@Model.Description</dd><dt>Job Date</dt><dd>@Model.JobDate.ToString("dd MMM yyyy")</dd><dt>Status</dt><dd><span class="status @Model.Status.ToString().ToLowerInvariant()">@Model.Status</span></dd><dt>Service</dt><dd>@(Model.ServiceStart?.ToString("dd MMM yyyy")??"-") → @(Model.ServiceEnd?.ToString("dd MMM yyyy")??"-")</dd><dt>Created By</dt><dd>@Model.CreatedByUser?.FullName</dd><dt>Created</dt><dd>@Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</dd></dl></section><section class="panel"><h3>Invoice & Payment</h3><dl class="detail-grid"><dt>Invoice No.</dt><dd>@(Model.InvoiceNumber??"-")</dd><dt>Invoice Date</dt><dd>@(Model.InvoiceDate?.ToString("dd MMM yyyy")??"-")</dd><dt>Payment</dt><dd>@Model.PaymentStatus</dd><dt>Processor</dt><dd>@(Model.ProcessorName??"-")</dd>@foreach(var t in currencyTotals){<dt>@t.Key Total</dt><dd><strong>@t.Value.ToString("N2")</strong></dd>}</dl></section></div>
<section class="panel mt-3"><h3>Line Items</h3><div class="table-responsive"><table class="table"><thead><tr><th>Description</th><th>Unit</th><th>Qty</th><th>Rate</th><th>Currency</th><th>Total</th></tr></thead><tbody>@foreach(var x in Model.Lines){<tr><td>@x.Description</td><td>@x.Unit?.Code</td><td>@x.Quantity.ToString("N3")</td><td>@x.UnitRate.ToString("N2")</td><td>@x.Currency?.Code</td><td><strong>@x.Total.ToString("N2")</strong></td></tr>}</tbody></table></div></section>
<section class="panel mt-3 danger-zone"><h3>Delete Job</h3><p>Deleting a job is restricted by permission and recorded in the audit log.</p><form asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Delete this job? This cannot be undone.');"><button class="btn btn-outline-danger"><i class="bi bi-trash"></i> Delete Job</button></form></section>
