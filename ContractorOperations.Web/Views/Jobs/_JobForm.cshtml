@model JobFormVm
@using System.Text.Json
@inject ContractorOperations.Web.Services.IPermissionService PermissionService
@{
    var canManageProjects = await PermissionService.HasPermissionAsync(User, "Projects.Manage");
    var canManageDepartments = await PermissionService.HasPermissionAsync(User, "Departments.Manage");
    var canManageContractors = await PermissionService.HasPermissionAsync(User, "Contractors.Manage");
}
<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
<div class="form-grid-4">
    <div><label class="form-label">Job Number</label><input class="form-control" value="@Model.JobNumber" disabled /></div>
    <div><label asp-for="JobDate" class="form-label"></label><input asp-for="JobDate" class="form-control"/></div>
    <div><div class="field-label-row"><label asp-for="ProjectId" class="form-label">Project</label>@if(canManageProjects){<a class="field-helper-link" asp-controller="MasterData" asp-action="Index" asp-route-type="projects" target="_blank" rel="noopener"><i class="bi bi-plus-circle"></i> Add / manage</a>}</div><select asp-for="ProjectId" asp-items="Model.Projects" class="form-select"><option value="">Select project</option></select><span asp-validation-for="ProjectId" class="text-danger small"></span></div>
    <div><div class="field-label-row"><label asp-for="DepartmentId" class="form-label">Department</label>@if(canManageDepartments){<a class="field-helper-link" asp-controller="MasterData" asp-action="Index" asp-route-type="departments" target="_blank" rel="noopener"><i class="bi bi-plus-circle"></i> Add / manage</a>}</div><select asp-for="DepartmentId" asp-items="Model.Departments" class="form-select"><option value="">Select department</option></select><span asp-validation-for="DepartmentId" class="text-danger small"></span></div>
    <div><div class="field-label-row"><label asp-for="ContractorId" class="form-label">Contractor</label>@if(canManageContractors){<a class="field-helper-link" asp-controller="MasterData" asp-action="Index" asp-route-type="contractors" target="_blank" rel="noopener"><i class="bi bi-plus-circle"></i> Add / manage</a>}</div><select asp-for="ContractorId" asp-items="Model.Contractors" class="form-select"><option value="">Select contractor</option></select><span asp-validation-for="ContractorId" class="text-danger small"></span></div>
    <div><label asp-for="Status" class="form-label"></label><select asp-for="Status" asp-items="Html.GetEnumSelectList<JobStatus>()" class="form-select"></select></div>
    <div><label asp-for="ServiceStart" class="form-label">Service Start</label><input asp-for="ServiceStart" class="form-control"/></div>
    <div><label asp-for="ServiceEnd" class="form-label">Service End</label><input asp-for="ServiceEnd" class="form-control"/></div>
</div>
<div class="mt-3"><label asp-for="Description" class="form-label">Job Description</label><textarea asp-for="Description" class="form-control" rows="3" placeholder="Describe the contractor work clearly..."></textarea><span asp-validation-for="Description" class="text-danger small"></span></div>
<div class="subsection-title"><div><h3>Job Line Items</h3><p>Duplicate line items are blocked automatically.</p></div><button type="button" class="btn btn-outline-primary btn-sm" id="addLine"><i class="bi bi-plus-lg"></i> Add line</button></div>
<div class="table-responsive"><table class="table line-table" id="linesTable"><thead><tr><th>Description</th><th style="width:130px">Unit</th><th style="width:120px">Qty</th><th style="width:140px">Rate</th><th style="width:110px">Currency</th><th style="width:120px">Total</th><th style="width:50px"></th></tr></thead><tbody>
@for(var i=0;i<Model.Lines.Count;i++){<tr class="line-row"><td><input asp-for="Lines[i].Description" class="form-control line-desc"/></td><td><select asp-for="Lines[i].UnitId" asp-items="Model.Units" class="form-select"></select></td><td><input asp-for="Lines[i].Quantity" class="form-control qty" step="0.001"/></td><td><input asp-for="Lines[i].UnitRate" class="form-control rate" step="0.01"/></td><td><select asp-for="Lines[i].CurrencyId" asp-items="Model.Currencies" class="form-select"></select></td><td class="line-total">0.00</td><td><button type="button" class="btn btn-link text-danger remove-line"><i class="bi bi-trash"></i></button></td></tr>}
</tbody></table></div>
<div class="subsection-title"><div><h3>Invoice & Processing</h3><p>Optional finance information for tracking payment status.</p></div></div>
<div class="form-grid-4"><div><label asp-for="InvoiceNumber" class="form-label">Invoice No.</label><input asp-for="InvoiceNumber" class="form-control"/></div><div><label asp-for="InvoiceDate" class="form-label"></label><input asp-for="InvoiceDate" class="form-control"/></div><div><label asp-for="PaymentStatus" class="form-label"></label><select asp-for="PaymentStatus" asp-items="Html.GetEnumSelectList<PaymentStatus>()" class="form-select"></select></div><div><label asp-for="ProcessorName" class="form-label">Processor</label><input asp-for="ProcessorName" class="form-control"/></div></div>
<script>
(function(){
const unitOptions=@Html.Raw(JsonSerializer.Serialize(Model.Units.Select(x=>new {value=x.Value,text=x.Text})));const currencyOptions=@Html.Raw(JsonSerializer.Serialize(Model.Currencies.Select(x=>new {value=x.Value,text=x.Text})));
const body=document.querySelector('#linesTable tbody');const add=document.getElementById('addLine');
function opts(arr){return arr.map(x=>`<option value="${x.value}">${x.text}</option>`).join('')}
function reindex(){[...body.querySelectorAll('tr')].forEach((r,i)=>{r.querySelectorAll('input,select').forEach(el=>{el.name=el.name.replace(/Lines\[\d+\]/,`Lines[${i}]`);el.id=el.id.replace(/Lines_\d+__/,`Lines_${i}__`);});});calc();}
function calc(){body.querySelectorAll('tr').forEach(r=>{const q=parseFloat(r.querySelector('.qty')?.value||0);const rate=parseFloat(r.querySelector('.rate')?.value||0);r.querySelector('.line-total').textContent=(q*rate).toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2});});}
add?.addEventListener('click',()=>{const i=body.querySelectorAll('tr').length;body.insertAdjacentHTML('beforeend',`<tr class="line-row"><td><input class="form-control line-desc" name="Lines[${i}].Description" /></td><td><select class="form-select" name="Lines[${i}].UnitId">${opts(unitOptions)}</select></td><td><input class="form-control qty" type="number" step="0.001" value="1" name="Lines[${i}].Quantity"/></td><td><input class="form-control rate" type="number" step="0.01" value="0" name="Lines[${i}].UnitRate"/></td><td><select class="form-select" name="Lines[${i}].CurrencyId">${opts(currencyOptions)}</select></td><td class="line-total">0.00</td><td><button type="button" class="btn btn-link text-danger remove-line"><i class="bi bi-trash"></i></button></td></tr>`);calc();});
body?.addEventListener('click',e=>{const b=e.target.closest('.remove-line');if(b&&body.querySelectorAll('tr').length>1){b.closest('tr').remove();reindex();}});body?.addEventListener('input',calc);calc();
})();
</script>
