@model ServiceApprovalDetailsVm
@{ Layout=null; var a=Model.Approval; string StageLabel(ApprovalStageStatus s) => s == ApprovalStageStatus.Pending ? "Waiting" : s.ToString(); }
<!DOCTYPE html><html><head><meta charset="utf-8"/><title>@(a.ApprovalNumber??"Service Approval")</title><style>@@page{size:A4;margin:9mm}*{box-sizing:border-box}body{font-family:Arial,sans-serif;color:#111;font-size:11px;margin:0}.toolbar{text-align:right;padding:8px;border-bottom:1px solid #ddd}.toolbar button{padding:8px 14px}.paper{max-width:190mm;margin:8mm auto}.title{text-align:center;margin:8px 0 12px}.title img{height:42px}.title h1{font-size:18px;margin:6px 0}.ref{font-size:12px;font-weight:bold}.doc-table{width:100%;border-collapse:collapse}.doc-table th,.doc-table td{border:1px solid #333;padding:6px;vertical-align:top}.doc-table th{width:22%;text-align:left;background:#fafafa}.items th{width:auto}.approval-grid{display:grid;grid-template-columns:1fr 1fr;border-left:1px solid #333;border-top:1px solid #333}.approval-box{min-height:120px;border-right:1px solid #333;border-bottom:1px solid #333;padding:7px}.approval-box strong{display:block}.approval-box small{display:block;margin-top:5px}.approval-box .signature{display:block;max-width:125px;max-height:48px;object-fit:contain;margin:8px 0 3px}.company-stamp{margin-top:12px;border:1px solid #333;padding:10px;min-height:96px;display:flex;justify-content:flex-end;align-items:center;gap:14px}.company-stamp img{max-width:125px;max-height:80px;object-fit:contain}.company-stamp small{max-width:160px}.footer{text-align:center;color:#777;margin-top:8px;font-size:9px}@@media print{.toolbar{display:none}.paper{margin:0;max-width:none}}</style></head><body><div class="toolbar"><button onclick="window.print()">Print / Save PDF</button></div><main class="paper"><div class="title"><img src="/images/bgp-logo.jpeg"/><h1>SERVICE BUSINESS APPROVAL SHEET</h1><div class="ref">Ref. No. @(a.ApprovalNumber ?? "Pending")</div></div>
<table class="doc-table"><tr><th>Type</th><td>@a.ServiceType</td><th>Vendor Selection Method</th><td>@(a.VendorSelectionMethod??"-")</td></tr><tr><th>BGP Entity / Project</th><td colspan="3">@a.Project?.Name</td></tr><tr><th>Requisition No.</th><td>@a.RequisitionNumber</td><th>Date</th><td>@a.ApprovalDate.ToString("dd MMM yyyy")</td></tr><tr><th>Approval Content</th><td colspan="3">@a.Description</td></tr><tr><th>Approved Amount</th><td colspan="3"><strong>@a.ServiceAmount.ToString("N2") @a.Currency?.Code</strong></td></tr></table>
<h3>Requisition Items</h3><table class="doc-table items"><thead><tr><th>No.</th><th>Description</th><th>Unit</th><th>Qty</th></tr></thead><tbody>@foreach(var x in Model.RequisitionItems){<tr><td>@x.ItemNumber</td><td>@x.Description</td><td>@x.Unit</td><td>@x.Quantity</td></tr>}</tbody></table>
<h3>Approval / Signature Record</h3><div class="approval-grid">@foreach(var s in a.Stages.OrderBy(x=>x.StageNumber)){<div class="approval-box"><strong>@s.Title</strong><div>Status: @StageLabel(s.Status)</div>@if(s.DecidedByUserId!=null){<small>@(Model.UserNames.TryGetValue(s.DecidedByUserId,out var n)?n:s.DecidedByUserId)</small>}@if(s.UserSignatureId.HasValue && s.Status==ApprovalStageStatus.Approved){<img class="signature" src="@Url.Action("UserSignature","Account",new{id=s.UserSignatureId.Value})" alt="Approver signature"/>}@if(s.DecidedAt.HasValue){<small>Date: @s.DecidedAt.Value.ToLocalTime().ToString("dd MMM yyyy HH:mm")</small>}@if(!string.IsNullOrWhiteSpace(s.Comment)){<small>Comment: @s.Comment</small>}</div>}</div>
@{ var stampUsage=Model.AssetUsages.FirstOrDefault(x=>x.OfficialDocumentAsset?.AssetType=="CompanyStamp"); }
@if(stampUsage?.OfficialDocumentAsset!=null){<div class="company-stamp"><div><strong>Official Company Stamp</strong><br/><small>Applied by @(Model.UserNames.TryGetValue(stampUsage.AppliedByUserId,out var stampUser)?stampUser:stampUsage.AppliedByUserId)<br/>@stampUsage.AppliedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</small></div><img src="@Url.Action("OfficialAsset","Settings",new{id=stampUsage.OfficialDocumentAssetId})" alt="Company stamp"/></div>}
<div class="footer">Generated from BGP Management System · Individual approver signatures are audit-linked to their user accounts.</div></main></body></html>
