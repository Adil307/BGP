@model ServiceApprovalFormVm
@{ ViewData["Title"]="Create Service Approval"; }
<div class="page-heading"><div><h1>Create Service Approval</h1><p>Only accepted requisitions are available. After creation, the record stays Waiting Approval until all required approval/signature stages are completed. The final Service Approval number is generated only after final acceptance.</p></div><div class="page-actions"><a class="btn btn-outline-secondary" asp-action="Index">Back</a></div></div>
<form method="post">
<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
<section class="panel mb-3"><div class="subsection-title"><div><h3>Approval Details</h3><p>Based on the BGP Service Business Approval Sheet reference.</p></div></div>
<input type="hidden" asp-for="ProjectId"/>
<div class="form-grid-2"><div><label asp-for="RequisitionNumber" class="form-label">Approved Requisition No.</label><select asp-for="RequisitionNumber" asp-items="Model.Requisitions" class="form-select"><option value="">Select approved requisition</option></select><span asp-validation-for="RequisitionNumber" class="text-danger small"></span></div><div><label class="form-label">Service Approval No.</label><input class="form-control" value="Pending — generated after final approval" disabled/></div><div><label asp-for="ApprovalDate" class="form-label">Date</label><input asp-for="ApprovalDate" class="form-control"/></div><div><label asp-for="ServiceType" class="form-label">Type</label><select asp-for="ServiceType" class="form-select"><option value="Expenditure">Expenditure</option><option value="Revenue">Revenue</option></select></div><div><label asp-for="ServiceAmount" class="form-label">Service Amount</label><input asp-for="ServiceAmount" class="form-control" step="0.01"/><span asp-validation-for="ServiceAmount" class="text-danger small"></span></div><div><label asp-for="CurrencyId" class="form-label">Currency</label><select asp-for="CurrencyId" asp-items="Model.Currencies" class="form-select"><option value="">Select currency</option></select></div><div class="grid-span-2"><label asp-for="VendorSelectionMethod" class="form-label">Vendor Selection Method</label><select asp-for="VendorSelectionMethod" class="form-select"><option value="">Select method</option><option>Public Tender</option><option>Invitation for Bidding</option><option>Comparative Enquiry</option><option>Competitive Bidding Procurement</option><option>Competitive Negotiations</option><option>Direct Procurement</option><option>Other</option></select></div><div class="grid-span-2"><label asp-for="Description" class="form-label">Approval Content / Service Details</label><textarea asp-for="Description" class="form-control" rows="5" placeholder="Describe the service, scope, quotation or supporting approval content..."></textarea><span asp-validation-for="Description" class="text-danger small"></span></div></div></section>
<section class="panel mb-3"><div class="subsection-title"><div><h3>Approval / Signature Workflow</h3><p>Choose three or four sequential approval stages. A rejection at any stage stops final approval but preserves the record.</p></div></div><div class="form-grid-2"><div><label asp-for="StageCount" class="form-label">Number of Approval Stages</label><select asp-for="StageCount" class="form-select" id="stageCount"><option value="3">3 stages</option><option value="4">4 stages</option></select></div></div>
<div class="approval-stage-editor mt-3">@for(var i=0;i<4;i++){<div class="approval-stage-config" data-stage="@(i+1)"><div class="stage-number">@(i+1)</div><div><label class="form-label">Stage Title</label><input class="form-control" name="StageTitles[@i]" value="@(Model.StageTitles.Count>i?Model.StageTitles[i]:$"Approver {i+1}")"/></div><div><label class="form-label">Assigned Approver</label><select class="form-select" name="ApproverUserIds[@i]"><option value="">Any authorized approver</option>@foreach(var u in Model.Approvers){if(Model.ApproverUserIds.Count>i && Model.ApproverUserIds[i]==u.Value){<option value="@u.Value" selected>@u.Text</option>}else{<option value="@u.Value">@u.Text</option>}}</select></div></div>}</div></section>
<div class="form-actions"><button class="btn btn-primary"><i class="bi bi-send-check"></i> Create & Send for Approval</button></div></form>
@section Scripts{<script>function toggleStages(){const n=parseInt(document.getElementById('stageCount').value||'4');document.querySelectorAll('.approval-stage-config').forEach((x,i)=>{x.style.display=i<n?'grid':'none';x.querySelectorAll('input,select').forEach(c=>c.disabled=i>=n);});}document.getElementById('stageCount').addEventListener('change',toggleStages);toggleStages();</script>}
