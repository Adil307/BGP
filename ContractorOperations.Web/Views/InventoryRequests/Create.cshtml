@model InventoryRequestFormVm
@{
    ViewData["Title"] = "New Inventory Request";
}

<div class="page-heading">
    <div><h1>New Inventory Request</h1><p>Submit an item request for a project and department. A unique request ID is generated automatically.</p></div>
    <a class="btn btn-light border" asp-action="Index"><i class="bi bi-arrow-left"></i> Back</a>
</div>

<section class="panel form-panel-narrow">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="All" class="text-danger mb-3"></div>
        <div class="form-grid-2">
            <div><label asp-for="ItemName" class="form-label">Item Name</label><input asp-for="ItemName" class="form-control" placeholder="Required item"/><span asp-validation-for="ItemName" class="text-danger"></span></div>
            <div><label asp-for="Category" class="form-label"></label><input asp-for="Category" class="form-control" placeholder="e.g. Tools, Safety, Consumables"/></div>
            <div><label asp-for="Quantity" class="form-label"></label><input asp-for="Quantity" class="form-control" type="number" step="0.001" min="0.001"/></div>
            <div><label asp-for="Unit" class="form-label"></label><input asp-for="Unit" class="form-control" placeholder="EA / KG / M / LOT"/></div>
            <div><label asp-for="DepartmentId" class="form-label">Department</label><select asp-for="DepartmentId" asp-items="Model.Departments" class="form-select"><option value="">-- Select Department --</option></select></div>
            <div><label asp-for="ProjectId" class="form-label">Project</label><select asp-for="ProjectId" asp-items="Model.Projects" class="form-select"><option value="">-- Optional Project --</option></select></div>
            <div><label asp-for="RequestDate" class="form-label">Request Date</label><input asp-for="RequestDate" class="form-control" type="date"/></div>
            <div><label asp-for="RequiredDate" class="form-label">Required Date</label><input asp-for="RequiredDate" class="form-control" type="date"/></div>
        </div>
        <div class="mt-3"><label asp-for="Purpose" class="form-label"></label><textarea asp-for="Purpose" class="form-control" rows="3" placeholder="Why is this item required?"></textarea></div>
        <div class="mt-3"><label asp-for="Notes" class="form-label"></label><textarea asp-for="Notes" class="form-control" rows="3" placeholder="Additional notes"></textarea></div>
        <div class="form-actions mt-4"><a class="btn btn-light border" asp-action="Index">Cancel</a><button class="btn btn-primary"><i class="bi bi-send"></i> Submit Request</button></div>
    </form>
</section>
