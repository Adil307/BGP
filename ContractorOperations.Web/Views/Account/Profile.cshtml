@model ProfileVm
@{ ViewData["Title"]="My Profile"; }
<div class="page-heading"><div><h1>My Profile</h1><p>Your account identity, role and department scope.</p></div><a class="btn btn-primary" asp-action="ChangePassword"><i class="bi bi-key"></i> Change Password</a></div>
<section class="panel"><dl class="detail-grid"><dt>Full Name</dt><dd>@Model.FullName</dd><dt>Email</dt><dd>@Model.Email</dd><dt>Role(s)</dt><dd>@Model.Roles</dd><dt>Departments</dt><dd>@(string.IsNullOrWhiteSpace(Model.Departments)?"All / not assigned":Model.Departments)</dd></dl></section>
