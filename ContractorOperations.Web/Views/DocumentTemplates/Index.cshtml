@model List<DocumentTemplate>
@{ ViewData["Title"]="Company Document Templates"; }
<div class="page-heading"><div><span class="reference-chip">MASTER FORMS</span><h1>Company Document Templates</h1><p>Controlled master layouts for Service Approval, Purchase Order and other company documents. Source files are stored as protected references; generated records use a version snapshot.</p></div><div class="page-actions"><a class="btn btn-outline-primary" asp-action="Create" asp-route-type="Service Approval"><i class="bi bi-file-earmark-check"></i> Service Approval</a><a class="btn btn-outline-primary" asp-action="Create" asp-route-type="Purchase Order"><i class="bi bi-receipt"></i> Purchase Order</a><a class="btn btn-primary" asp-action="Create" asp-route-type="Custom"><i class="bi bi-plus-lg"></i> Custom Template</a></div></div>
<section class="panel mb-3"><div class="document-policy-note"><i class="bi bi-info-circle"></i><div><strong>How this library works</strong><p>Upload the company's original PDF/DOCX/image as a protected source reference, then define the clean printable layout with dynamic placeholders. Signature and stamp placeholders determine the exact automatic placement position.</p></div></div></section>
<section class="panel p-0 overflow-hidden"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Name</th><th>Type</th><th>Source</th><th>Editable / Sign Slots</th><th>Updated</th><th>Actions</th></tr></thead><tbody>
@if(!Model.Any()){<tr><td colspan="6" class="text-center py-5 text-muted">No company document templates yet.</td></tr>}
@foreach(var x in Model){var editCount=string.IsNullOrWhiteSpace(x.EditableFieldLabels)?0:x.EditableFieldLabels.Split('\n',StringSplitOptions.RemoveEmptyEntries).Length;var signCount=string.IsNullOrWhiteSpace(x.SignatureSlotLabels)?0:x.SignatureSlotLabels.Split('\n',StringSplitOptions.RemoveEmptyEntries).Length;<tr><td><strong>@x.Name</strong>@if(!string.IsNullOrWhiteSpace(x.Description)){<small class="d-block text-muted">@x.Description</small>}</td><td><span class="reference-chip">@x.DocumentType</span></td><td>@if(!string.IsNullOrWhiteSpace(x.SourceOriginalFileName)){<a asp-action="Source" asp-route-id="@x.Id" target="_blank"><i class="bi bi-paperclip"></i> @x.SourceOriginalFileName</a>}else{<span class="text-muted">No source attached</span>}</td><td><small>@editCount editable field(s)<br/>@signCount manual signature slot(s)</small></td><td>@x.UpdatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td><td><div class="action-row"><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@x.Id"><i class="bi bi-pencil"></i> Edit</a><a class="btn btn-sm btn-outline-secondary" asp-action="Preview" asp-route-id="@x.Id" target="_blank"><i class="bi bi-eye"></i> Preview</a><form asp-action="Duplicate" asp-route-id="@x.Id" method="post"><button class="btn btn-sm btn-outline-secondary" title="Duplicate"><i class="bi bi-copy"></i></button></form><form asp-action="Delete" asp-route-id="@x.Id" method="post" onsubmit="return confirm('Remove this master template from the active library? Existing generated documents are not affected.');"><button class="btn btn-sm btn-outline-danger" title="Deactivate"><i class="bi bi-trash"></i></button></form></div></td></tr>}
</tbody></table></div></section>
