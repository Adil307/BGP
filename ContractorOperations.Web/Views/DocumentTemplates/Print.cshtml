@{ Layout=null; var template=(DocumentTemplate)ViewBag.Template; }
<!DOCTYPE html><html><head><meta charset="utf-8"/><title>@template.Name</title><style>@@page{size:A4;margin:10mm}*{box-sizing:border-box}body{font-family:Arial,sans-serif;color:#111;margin:0;font-size:11px}.toolbar{padding:9px;text-align:right;border-bottom:1px solid #ddd}.toolbar button{padding:8px 14px}.paper{max-width:190mm;margin:10mm auto}.doc-header{text-align:center;margin-bottom:12px}.doc-header h1{font-size:18px;margin:5px 0}.doc-logo{max-height:46px;max-width:100px}.doc-table{width:100%;border-collapse:collapse;margin:8px 0}.doc-table th,.doc-table td{border:1px solid #333;padding:6px;vertical-align:top}.doc-table th{background:#fafafa;text-align:left}.document-two-col,.signature-grid,.approval-sign-grid{display:grid;grid-template-columns:1fr 1fr;gap:0;margin-top:10px}.document-two-col>div,.signature-grid>div,.approval-sign-grid>div{border:1px solid #333;padding:8px;min-height:90px}.approval-sign-grid>div{min-height:115px}.doc-signature{display:block;max-width:125px;max-height:55px;object-fit:contain;margin:6px 0}.doc-stamp{display:block;max-width:130px;max-height:90px;object-fit:contain;margin:6px 0}.terms-box,.stamp-area{border:1px solid #333;padding:8px;margin-top:10px}.stamp-area{min-height:95px}.paper small{display:block;margin-top:4px;color:#555}@@media print{.toolbar{display:none}.paper{margin:0;max-width:none}}</style></head><body><div class="toolbar"><button onclick="window.print()">Print / Save PDF</button></div><article class="paper">@Html.Raw((string)ViewBag.RenderedHtml)</article><script>if(new URLSearchParams(location.search).get('autoprint')==='1')window.print();</script></body></html>
