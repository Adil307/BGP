@{ var template=(DocumentTemplate)ViewBag.Template; ViewData["Title"]=$"Preview - {template.Name}"; }
<div class="page-heading no-print"><div><h1>@template.Name</h1><p>Master template preview. Dynamic values appear when a linked BGP record is supplied.</p></div><div class="page-actions">@if(!string.IsNullOrWhiteSpace(template.SourceOriginalFileName)){<a class="btn btn-outline-secondary" asp-action="Source" asp-route-id="@template.Id" target="_blank"><i class="bi bi-paperclip"></i> Source</a>}<a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@template.Id">Edit Master</a><a class="btn btn-primary" asp-action="Print" asp-route-id="@template.Id" target="_blank"><i class="bi bi-printer"></i> Print / PDF</a></div></div>
<div class="print-document-shell"><article class="print-document">@Html.Raw((string)ViewBag.RenderedHtml)</article></div>
