@model DocumentTemplateFormVm
@{ ViewData["Title"]=Model.Id.HasValue?"Edit Company Template":"New Company Template"; }
<div class="page-heading"><div><h1>@ViewData["Title"]</h1><p>Build a stable company document layout. Business users later edit only approved text fields; the master HTML stays protected.</p></div><div class="page-actions">@if(Model.Id.HasValue){<a class="btn btn-outline-secondary" asp-action="Preview" asp-route-id="@Model.Id" target="_blank"><i class="bi bi-eye"></i> Preview</a>}<a class="btn btn-outline-secondary" asp-action="Index">Back</a></div></div>
<form method="post" enctype="multipart/form-data">
@if(Model.Id.HasValue){<input type="hidden" asp-for="Id"/>}
<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
<section class="panel mb-3"><div class="form-grid-2"><div><label asp-for="Name" class="form-label">Template Name</label><input asp-for="Name" class="form-control" placeholder="e.g. Service Business Approval Sheet"/><span asp-validation-for="Name" class="text-danger small"></span></div><div><label asp-for="DocumentType" class="form-label">Document Type</label><select asp-for="DocumentType" class="form-select"><option>Service Approval</option><option>Purchase Order</option><option>Approval Form</option><option>Letter</option><option>Internal Approval</option><option>Custom</option></select></div><div class="grid-span-2"><label asp-for="Description" class="form-label">Purpose / Description</label><textarea asp-for="Description" class="form-control" rows="2" placeholder="Short explanation for users choosing this template"></textarea></div></div></section>
<section class="panel mb-3"><div class="subsection-title mt-0 pt-0 border-0"><div><h3>Original Company Source Document</h3><p>Attach the company's original PDF, Word, Excel or image for controlled reference. It is stored under App_Data, not as a public file.</p></div></div><div class="source-upload-row"><div>@if(!string.IsNullOrWhiteSpace(Model.ExistingSourceFileName)){<div class="source-file-existing"><i class="bi bi-file-earmark-lock"></i><div><strong>@Model.ExistingSourceFileName</strong><span>Existing protected source file</span></div></div>}else{<div class="official-asset-empty">No source file attached</div>}</div><div><label class="form-label">@(Model.Id.HasValue?"Replace source file":"Upload source file")</label><input class="form-control" type="file" name="sourceFile" accept=".pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png"/><small class="text-muted">Maximum 25 MB. This source is reference material; the HTML layout below controls clean print/PDF output.</small></div></div></section>
<section class="panel mb-3"><div class="subsection-title mt-0 pt-0 border-0"><div><h3>Controlled Editable Fields</h3><p>Up to four safe text areas can be changed on each generated document without exposing raw HTML editing to normal users.</p></div></div><div class="form-grid-2"><div><label asp-for="EditableFieldLabels" class="form-label">Editable field labels — one per line</label><textarea asp-for="EditableFieldLabels" class="form-control" rows="5" placeholder="Quotation No.&#10;Service Terms&#10;Remarks"></textarea><small class="text-muted">Use placeholders {{CustomText1}} ... {{CustomText4}} in the layout.</small></div><div><label asp-for="SignatureSlotLabels" class="form-label">Manual signature slot labels — one per line</label><textarea asp-for="SignatureSlotLabels" class="form-control" rows="5" placeholder="Company Authorized Signatory&#10;Finance Manager"></textarea><small class="text-muted">Use {{Signer1Name}}, {{Signer1Signature}}, {{Signer1Date}} ... up to slot 4. Service Approval workflow signatures use Stage placeholders instead.</small></div></div></section>
<section class="panel document-builder"><div class="subsection-title mt-0 pt-0 border-0"><div><h3>Printable Layout Builder</h3><p>Dynamic data and signatures are inserted exactly where their placeholders appear. This defines the final A4 document, not the application screen.</p></div></div>
<div class="document-toolbar no-print">
<button type="button" data-insert="<h2>Heading</h2>"><i class="bi bi-type-h2"></i> Heading</button><button type="button" data-insert="<p>Text...</p>"><i class="bi bi-text-paragraph"></i> Text</button><button type="button" data-insert="<table class=&quot;doc-table&quot;><tr><th>Field</th><th>Value</th></tr><tr><td>Label</td><td>Value</td></tr></table>"><i class="bi bi-table"></i> Table</button>
@foreach(var p in new[]{"{{Logo}}","{{CompanyName}}","{{Project}}","{{Department}}","{{RequisitionNumber}}","{{RequisitionItemsTable}}","{{JobNumber}}","{{JobDescription}}","{{JobItemsTable}}","{{ServiceApprovalNumber}}","{{ServiceAmount}}","{{ServiceDescription}}","{{ServiceType}}","{{VendorSelectionMethod}}","{{Date}}","{{VendorName}}","{{ApprovedBy}}","{{CreatedBy}}","{{CustomText1}}","{{CustomText2}}","{{CustomText3}}","{{CustomText4}}","{{Stage1Name}}","{{Stage1Signature}}","{{Stage1Date}}","{{Stage2Name}}","{{Stage2Signature}}","{{Stage2Date}}","{{Stage3Name}}","{{Stage3Signature}}","{{Stage3Date}}","{{Stage4Name}}","{{Stage4Signature}}","{{Stage4Date}}","{{Signer1Name}}","{{Signer1Signature}}","{{Signer1Date}}","{{Signer2Name}}","{{Signer2Signature}}","{{Signer2Date}}","{{CompanyStamp}}"}){<button type="button" data-insert="@p">@p.Replace("{{","").Replace("}}","")</button>}
</div>
<textarea asp-for="HtmlContent" id="templateEditor" class="form-control template-editor" rows="28" spellcheck="false"></textarea><span asp-validation-for="HtmlContent" class="text-danger small"></span>
<div class="document-policy-note mt-3"><i class="bi bi-shield-check"></i><div><strong>Professional signing rule</strong><p>Do not paste a person's signature image into template HTML. Use Stage or Signer placeholders so BGP records the actual user, signature version and time.</p></div></div>
<div class="form-actions"><button class="btn btn-primary"><i class="bi bi-check2"></i> Save Master Template</button></div></section></form>
@section Scripts{<script>document.querySelectorAll('[data-insert]').forEach(b=>b.addEventListener('click',()=>{const e=document.getElementById('templateEditor');const s=e.selectionStart||0,n=e.selectionEnd||0,t=b.dataset.insert;e.value=e.value.slice(0,s)+t+e.value.slice(n);e.focus();e.selectionStart=e.selectionEnd=s+t.length;}));</script>}
